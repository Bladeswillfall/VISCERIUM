{
  "name": "obsidian-viscerium-timelines",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs development",
    "sync:vault": "node scripts/sync-vault.mjs",
    "build:sync": "npm run build && npm run sync:vault"
  },
  "dependencies": {
    "vis-timeline": "8.5.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "obsidian": "^1.8.7"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0 <12",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
