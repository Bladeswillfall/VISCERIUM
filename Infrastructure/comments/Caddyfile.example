{
    servers {
        # Cloudflare Tunnel is expected to run on this host. Only the local
        # tunnel hop may supply client-address headers; direct internet peers
        # cannot make Caddy trust spoofed forwarding values.
        trusted_proxies static 127.0.0.1/32 ::1/128
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP X-Forwarded-For
    }
}

comments.viscerium.co.uk {
    request_body {
        max_size 64KB
    }

    @remarkIframe {
        method GET HEAD
        path /web/iframe.html
    }

    @commentImageUpload {
        method POST
        path /api/v1/picture
    }

    @commentCreate {
        method POST
        path /api/v1/comment
    }

    @commentEdit {
        method PUT
        path_regexp commentEdit ^/api/v1/comment/[^/]+$
    }

    route {
        # Serve the reviewed Remark42 v1.16.4 iframe shell locally so the UI
        # does not advertise an image-upload capability VISCERIUM disables.
        # All Remark42 JS/CSS assets referenced by the shell still come from
        # the pinned Remark42 container through the fallback proxy below.
        handle @remarkIframe {
            root * /srv/remark42/ui
            rewrite * /iframe.html
            header {
                Cache-Control "no-cache"
                Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; connect-src 'self'; frame-src 'self' mailto:; img-src *; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'none'; object-src 'none'; frame-ancestors 'self' https://www.viscerium.co.uk https://viscerium.co.uk https://replace-giscus-with-remark42.viscerium-site.pages.dev;"
                Permissions-Policy "accelerometer=(), autoplay=(), camera=(), cross-origin-isolated=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), keyboard-map=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), xr-spatial-tracking=(), clipboard-read=(), clipboard-write=(), gamepad=(), hid=(), idle-detection=(), interest-cohort=(), serial=(), unload=(), window-management=()"
                Referrer-Policy "strict-origin-when-cross-origin"
                X-Content-Type-Options "nosniff"
            }
            file_server
        }

        # VISCERIUM permits avatars supplied by identities, but not uploads
        # attached to comments.
        respond @commentImageUpload 404

        # The local header is authoritative only because internet clients can
        # never reach the gateway directly and Caddy overwrites it from its
        # resolved, trusted-proxy-aware client address.
        handle @commentCreate {
            reverse_proxy 127.0.0.1:8081 {
                header_up -X-Viscerium-Client-IP
                header_up X-Viscerium-Client-IP {client_ip}
                header_up -X-Forwarded-For
                header_up X-Forwarded-For {client_ip}
                header_up X-Real-IP {client_ip}
            }
        }

        handle @commentEdit {
            reverse_proxy 127.0.0.1:8081 {
                header_up -X-Viscerium-Client-IP
                header_up X-Viscerium-Client-IP {client_ip}
                header_up -X-Forwarded-For
                header_up X-Forwarded-For {client_ip}
                header_up X-Real-IP {client_ip}
            }
        }

        # Reads, authentication, config and the stock Remark42 web app do not
        # depend on the write gateway. If the gateway fails, existing comments
        # remain readable while new writes fail closed.
        handle {
            reverse_proxy 127.0.0.1:8080 {
                header_up -X-Forwarded-For
                header_up X-Forwarded-For {client_ip}
                header_up X-Real-IP {client_ip}
            }
        }
    }
}
