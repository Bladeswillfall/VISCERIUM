[Unit]
Description=Archive VISCERIUM aggregate analytics
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/viscerium-analytics
EnvironmentFile=/etc/viscerium/analytics.env
ExecStart=/usr/bin/node /opt/viscerium-analytics/archive.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
