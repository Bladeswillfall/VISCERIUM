filters:
  and:
    - file.ext == "md"
    - file.path != "Home.md"
    - '!file.inFolder("System")'
    - '!file.inFolder("Templates")'
    - '!file.inFolder("Demo")'
formulas:
  display_title: 'if(title.isEmpty(), file.name, title)'
  note_link: 'file.asLink(formula.display_title)'
  area: 'if(file.inFolder("Lore"), "CANON", if(file.inFolder("Stories"), "WRITING", if(file.inFolder("Drafts"), "WIP", if(file.inFolder("Private"), "PRIVATE", "NOTE"))))'
  era_context: 'if(!list(eras).filter(value != null).isEmpty(), list(eras).filter(value != null).join(" · "), if(era.isEmpty(), "—", era))'
properties:
  formula.note_link:
    displayName: Note
  formula.area:
    displayName: Area
  type:
    displayName: Type
  status:
    displayName: Status
  formula.era_context:
    displayName: Era / scope
  development_level:
    displayName: Development
  file.folder:
    displayName: Folder
  file.mtime:
    displayName: Modified
views:
  - type: table
    name: Recently edited
    limit: 6
    order:
      - formula.note_link
      - formula.area
      - type
      - status
      - formula.era_context
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: All lore
    filters:
      and:
        - file.inFolder("Lore")
    order:
      - formula.note_link
      - type
      - formula.era_context
      - status
      - development_level
      - file.folder
      - file.mtime
    sort:
      - property: formula.display_title
        direction: ASC
  - type: table
    name: By era
    filters:
      and:
        - file.inFolder("Lore")
    groupBy:
      property: formula.era_context
      direction: ASC
    order:
      - formula.note_link
      - type
      - status
      - development_level
      - file.mtime
    sort:
      - property: formula.display_title
        direction: ASC
  - type: table
    name: By type
    filters:
      and:
        - file.inFolder("Lore")
    groupBy:
      property: type
      direction: ASC
    order:
      - formula.note_link
      - formula.era_context
      - status
      - development_level
      - file.mtime
    sort:
      - property: formula.display_title
        direction: ASC
  - type: table
    name: Draft workspace
    filters:
      and:
        - file.inFolder("Drafts")
    order:
      - formula.note_link
      - type
      - formula.era_context
      - status
      - development_level
      - file.folder
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: Published lore
    filters:
      and:
        - file.inFolder("Lore")
        - status == "published"
    order:
      - formula.note_link
      - type
      - formula.era_context
      - development_level
      - file.mtime
    sort:
      - property: formula.display_title
        direction: ASC
