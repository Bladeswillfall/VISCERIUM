# Node / Astro
Site/node_modules/
Site/dist/
Site/.astro/
Site/src/data/timelines/*.json
Site/src/data/image-variants.json
Site/public/assets/image-variants.json
Site/public/assets/images/variants/
Site/public/assets/maps/variants/
Site/timeline-browser-diagnostics/
Site/test-results/
Site/playwright-report/

# Raster artwork policy
# VISCERIUM keeps raster images as WebP. SVG remains allowed for genuine vectors.
*.[Pp][Nn][Gg]
*.[Jj][Pp][Gg]
*.[Jj][Pp][Ee][Gg]
*.[Gg][Ii][Ff]
*.[Bb][Mm][Pp]
*.[Aa][Vv][Ii][Ff]
*.[Tt][Ii][Ff]
*.[Tt][Ii][Ff][Ff]
*.[Hh][Ee][Ii][Cc]
*.[Hh][Ee][Ii][Ff]

# Obsidian timeline plugin build artifacts
Tools/obsidian-viscerium-timelines/node_modules/
Tools/obsidian-viscerium-timelines/dist/

# Installed Obsidian community plugins
# Track enabled plugin IDs in Vault/.obsidian/community-plugins.json.
# Track tested versions in Vault/System/Obsidian Plugin Profile.json.
# Ignore upstream runtime code, manifests, maps, workers, binaries, and local state.
Vault/.obsidian/plugins/*/*

# Intentional shared third-party plugin settings.
# Add a new exception only after reviewing the file for secrets, caches, and device state.
!Vault/.obsidian/plugins/image-converter/data.json
!Vault/.obsidian/plugins/editing-toolbar/data.json
!Vault/.obsidian/plugins/breadcrumbs/data.json
!Vault/.obsidian/plugins/templater-obsidian/data.json
!Vault/.obsidian/plugins/auto-properties/data.json
!Vault/.obsidian/plugins/metadata-menu/data.json
!Vault/.obsidian/plugins/iconic/data.json
!Vault/.obsidian/plugins/zoom-map/data.json
!Vault/.obsidian/plugins/table-editor-obsidian/data.json
!Vault/.obsidian/plugins/chronos/data.json
!Vault/.obsidian/plugins/dataview/data.json
!Vault/.obsidian/plugins/obsidian-git/data.json
!Vault/.obsidian/plugins/obsidian-style-settings/data.json
!Vault/.obsidian/plugins/daily-activity/data.json
!Vault/.obsidian/plugins/journal-bases/data.json

# MySnippets is intentionally vendored because the community-store 1.2.3
# bundle is incompatible with current Obsidian menu/toggle behaviour.
!Vault/.obsidian/plugins/mysnippets-plugin/
!Vault/.obsidian/plugins/mysnippets-plugin/**

# VISCERIUM Timelines is maintained in this repository. Track the runnable
# bundle so the vault integration works immediately after pulling.
!Vault/.obsidian/plugins/viscerium-timelines/
!Vault/.obsidian/plugins/viscerium-timelines/**

# First-party VISCERIUM creator plugins also ship with their runnable bundles.
!Vault/.obsidian/plugins/viscerium-creator-tools/
!Vault/.obsidian/plugins/viscerium-creator-tools/**
!Vault/.obsidian/plugins/viscerium-layout-tools/
!Vault/.obsidian/plugins/viscerium-layout-tools/**
!Vault/.obsidian/plugins/viscerium-image-tools/
!Vault/.obsidian/plugins/viscerium-image-tools/**
!Vault/.obsidian/plugins/viscerium-journal-tools/
!Vault/.obsidian/plugins/viscerium-journal-tools/**

# Plugin-generated settings backups and caches are device-local churn.
Vault/.obsidian/plugins/*/data.json.backup*
Vault/.obsidian/plugins/*/cache/
Vault/.obsidian/plugins/*/.cache/

# Obsidian workspace state
Vault/.obsidian/workspace.json
Vault/.obsidian/workspace-mobile.json
Vault/.obsidian/workspace*.json

# OS junk
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!**/.env.example
Site/.dev.vars

# Local-only/private authoring
Vault/Drafts/
Vault/Private/
Vault/Stories/
