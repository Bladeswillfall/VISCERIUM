{
  "name": "viscerium",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.18.0",
  "scripts": {
    "dev": "node scripts/build-content.mjs --mode=dev && astro dev",
    "baseline:check": "node scripts/check-repository-baseline.mjs && npm run lint:complexity",
    "lint:complexity": "node scripts/check-complexity.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "doctor:vault": "node scripts/vault-doctor.mjs && node scripts/validate-vault-assets.mjs",
    "validate:vault": "node scripts/validate-vault-notes.mjs",
    "validate:timelines": "node scripts/generate-timeline-data.mjs --validate-only",
    "validate:icons": "node scripts/validate-icon-output.mjs",
    "contributors:sync": "node scripts/sync-contributor-avatars.mjs",
    "notices:update": "node scripts/update-rights-notices.mjs --write",
    "notices:check": "node scripts/update-rights-notices.mjs --check",
    "rights:update": "npm run notices:update",
    "rights:check": "npm run notices:check",
    "sync": "node scripts/build-content.mjs --mode=sync",
    "validate": "node scripts/validate-content.mjs",
    "generate:maps": "node scripts/generate-map-data.mjs",
    "generate:relationships": "node scripts/generate-relationship-data.mjs",
    "generate:timelines": "node scripts/generate-timeline-data.mjs",
    "benchmark:timelines": "node scripts/benchmark-timelines.mjs",
    "frontmatter:folders:audit": "node scripts/backfill-folder-frontmatter.mjs",
    "frontmatter:folders:write": "node scripts/backfill-folder-frontmatter.mjs --write",
    "migration:sidebars": "node scripts/normalise-worldanvil-vehicle-sidebars.mjs && node scripts/normalise-worldanvil-sidebars.mjs",
    "migration:sidebars:write": "node scripts/normalise-worldanvil-vehicle-sidebars.mjs --write && node scripts/normalise-worldanvil-sidebars.mjs --write",
    "migration:sidebar-wikilinks": "node scripts/migrate-sidebar-wikilinks.mjs",
    "migration:sidebar-wikilinks:write": "node scripts/migrate-sidebar-wikilinks.mjs --write",
    "migration:worldanvil:integrate": "node scripts/integrate-worldanvil-import.mjs",
    "migration:worldanvil:prepare": "node scripts/prepare-worldanvil-import-frontmatter.mjs",
    "migration:worldanvil:prepare:write": "node scripts/prepare-worldanvil-import-frontmatter.mjs --write",
    "migration:worldanvil:integrate:write": "node scripts/integrate-worldanvil-import.mjs --write && node scripts/prepare-worldanvil-import-frontmatter.mjs --write",
    "migration:worldanvil:filenames": "node scripts/normalise-worldanvil-filenames.mjs",
    "migration:worldanvil:filenames:write": "node scripts/normalise-worldanvil-filenames.mjs --write",
    "test:unit": "node --test tests/*.test.mjs",
    "prebuild": "node scripts/build-content.mjs --mode=build && npm run check:astro",
    "build": "astro build",
    "performance:check": "node scripts/check-performance-budgets.mjs",
    "security:artifacts": "node scripts/check-public-artifacts.mjs",
    "postbuild": "npm run validate:icons && node --test tests/i18n-output.postbuild.mjs && npm run security:artifacts && npm run performance:check",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run baseline:check && npm run doctor:vault && npm run notices:check && npm run test:unit && npm run build",
    "check:astro": "astro check"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "^0.42.4",
    "astro": "^7.3.5",
    "cytoscape": "3.34.3",
    "cytoscape-dagre": "4.0.1",
    "fuse.js": "7.5.0",
    "gray-matter": "^4.0.3",
    "leaflet": "1.9.4",
    "leaflet.control.layers.tree": "1.2.0",
    "moment": "2.31.0",
    "starlight-changelogs": "^0.7.0",
    "starlight-links-validator": "^0.26.0",
    "starlight-scroll-to-top": "^2.0.0",
    "starlight-tags": "^2.0.0",
    "starlight-telescope": "^2.0.0",
    "vis-data": "8.0.4",
    "vis-timeline": "8.5.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0 <12",
      "onFail": "error"
    }
  },
  "overrides": {
    "@ascorbic/loader-utils": {
      "astro": "$astro"
    },
    "astro-integration-kit": {
      "astro": "$astro"
    },
    "picomatch": "^4.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.22",
    "eslint": "10.11.0",
    "typescript": "6.0.3"
  }
}
