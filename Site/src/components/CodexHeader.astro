---
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import siteConfig from '../../site.config.mjs';
import CodexSearch from './CodexSearch.astro';
import EraContextControls from './EraContextControls.astro';
import ReaderSettings from './ReaderSettings.astro';

const { t } = Astro.locals;
---

<script is:inline>
  (() => {
    const desktop = window.matchMedia('(min-width: 800px)').matches;
    document.documentElement.toggleAttribute('data-codex-wide-header', desktop);
    document.documentElement.toggleAttribute('data-codex-mobile-header', !desktop);
  })();
</script>

<div class="header codex-header">
  <div class="title-wrapper sl-flex h-card">
    <button
      class="codex-sidebar-toggle"
      type="button"
      data-codex-sidebar-toggle
      aria-controls="starlight__sidebar"
      aria-expanded="false"
      aria-label={t('menuButton.accessibleLabel')}
      data-sidebar-show={t('viscerium.sidebar.show')}
      data-sidebar-hide={t('viscerium.sidebar.hide')}
    >
      <span aria-hidden="true">☰</span>
    </button>
    <SiteTitle />
    <span hidden aria-hidden="true">
      <span class="p-name">{siteConfig.title}</span>
      <a class="u-url" href={siteConfig.site}>{siteConfig.title}</a>
    </span>
  </div>

  <div class="codex-header-search print:hidden" data-codex-header-search>
    <CodexSearch />
  </div>

  <!--
    Telescope injects its hidden controller into `.right-group`.
    `CodexSearch` provides the visible search button.
    Keep `.right-group` because Telescope uses this class to attach the controller.
  -->
  <div class="right-group codex-header-controls print:hidden" data-codex-header-controls>
    <EraContextControls />
    <ReaderSettings />
    <LanguageSelect />
  </div>
</div>

<style is:global>
  /* Draws the grain texture above the page content. */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 999999;
    background: url('/assets/images/codex-noise-v2.webp') repeat;
    opacity: .2;
    visibility: visible;
    pointer-events: none;
    display: block;
    mix-blend-mode: soft-light;
  }

  :root[data-theme='light'] body::before {
    opacity: .2;
  }

  /* The grain is barely visible on small screens but still costs a fixed paint layer and request. */
  @media (max-width: 40rem) {
    body::before,
    :root[data-theme='light'] body::before {
      display: none;
    }
  }

  :root[data-exploration-focus] .codex-header {
    display: none !important;
  }

  @media print, (forced-colors: active) {
    body::before {
      display: none;
    }
  }
</style>

<script>
  import '../scripts/telescope-scope.js';
  import '../scripts/codex-shell.js';
</script>
