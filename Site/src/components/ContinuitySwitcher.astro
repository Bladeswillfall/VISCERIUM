---
import { HISTORICAL_ERAS, normaliseEra } from '../lib/era-context.mjs';

const { starlightRoute } = Astro.locals;
const { t } = Astro.locals;
const entry = starlightRoute.entry.data;
type ContinuityEra = 'CITADEL' | 'SMOG' | 'NEARSIGHT' | 'ENTROPY' | 'Universal';
const continuity = entry.continuity && typeof entry.continuity === 'object' ? entry.continuity : undefined;
const editions = (continuity?.editions ?? {}) as Partial<Record<ContinuityEra, string>>;
const historicalEras = HISTORICAL_ERAS as ContinuityEra[];
const hub = typeof continuity?.hub === 'string' ? continuity.hub : '';
const rawEra = Array.isArray(entry.era) ? entry.era[0] : entry.era;
const currentEra = normaliseEra(rawEra);
const isHub = entry.type === 'continuity';
const hasHistoricalEditions = historicalEras.some((era) => typeof editions[era] === 'string');
const eraChoices: ContinuityEra[] = hasHistoricalEditions ? historicalEras : ['Universal'];
const showSwitcher = Boolean(hub) && eraChoices.some((era) => typeof editions[era] === 'string');
---

{showSwitcher ? (
  <nav class="codex-continuity-switcher" aria-label={t('viscerium.era.editions')} data-pagefind-ignore>
    <span class="codex-continuity-switcher__label">{t('viscerium.era.label')}</span>
    <a
      href={hub}
      class:list={{ 'codex-continuity-chip': true, active: isHub }}
      aria-current={isHub ? 'page' : undefined}
      data-era-exit
    >{t('viscerium.era.all')}</a>
    {eraChoices.map((era) => typeof editions[era] === 'string' ? (
      <a
        href={editions[era]}
        class:list={{ 'codex-continuity-chip': true, active: currentEra === era && !isHub }}
        aria-current={currentEra === era && !isHub ? 'page' : undefined}
      >{era}</a>
    ) : (
      <span class="codex-continuity-chip unavailable" aria-disabled="true" title={t('viscerium.era.unavailable', { era, interpolation: { escapeValue: false } })}>{era}</span>
    ))}
  </nav>
) : currentEra === 'Universal' ? (
  <div class="codex-universal-badge" data-pagefind-ignore>{t('viscerium.era.universal')}</div>
) : null}
