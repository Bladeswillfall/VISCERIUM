---
import contributorAssets from '../data/contributor-avatars.json';
import contributorRegistry from '../data/contributors.json';
import { buildRoleSegments, normalizeRole, normalizeRoles } from '../lib/contributors.mjs';
import { formatList } from '../lib/i18n.mjs';

type ContributorProfile = {
  name: string;
  url: string;
};

type Contributor = ContributorProfile & {
  id: string;
  roles: string[];
  avatarSrc: string;
};

const profiles = contributorRegistry.profiles as Record<string, ContributorProfile>;
const avatarPaths = contributorAssets as Record<string, string>;
const { starlightRoute, t } = Astro.locals;
const locale = starlightRoute.lang;
const entry = Astro.locals.starlightRoute?.entry?.data ?? {};
const routeId = String(entry.slug ?? Astro.locals.starlightRoute?.entry?.id ?? '')
  .replace(/\.(md|mdx)$/i, '')
  .replace(/^\/+|\/+$/g, '');
const eligibleTypes = new Set(['article', 'character', 'event', 'era', 'faction', 'image', 'location', 'map', 'timeline']);
const useDefaults = entry.defaultContributors !== false
  && entry.status === 'published'
  && routeId !== 'index'
  && eligibleTypes.has(entry.type ?? 'article');
const requested = [
  ...(useDefaults ? contributorRegistry.defaultContributors : []),
  ...(Array.isArray(entry.contributors) ? entry.contributors : []),
];
const byId = new Map<string, Contributor>();

for (const item of requested) {
  const reference = typeof item === 'string' ? { id: item } : item;
  const id = reference?.id?.trim().toLowerCase();
  if (!id || !profiles[id]) continue;

  const contributor = byId.get(id) ?? {
    id,
    ...profiles[id],
    roles: [],
    avatarSrc: avatarPaths[id] ?? avatarPaths.fallback,
  };
  const roles = Array.isArray(reference.roles)
    ? reference.roles
    : [reference.role ?? t('viscerium.contributors.defaultRole')];
  contributor.roles = normalizeRoles([...contributor.roles, ...roles]);
  byId.set(id, contributor);
}

const contributors = [...byId.values()].sort((a, b) => (
  Number(b.roles.some((role) => normalizeRole(role) === 'author'))
  - Number(a.roles.some((role) => normalizeRole(role) === 'author'))
  || a.name.localeCompare(b.name, locale)
));
const collapsedLimit = Math.max(1, Number(contributorRegistry.collapsedLimit) || 7);
---

{contributors.length > 0 && (
  <section class="codex-contributors" aria-label={t('viscerium.contributors.title')}>
    <details open={contributors.length <= collapsedLimit}>
      <summary>{t('viscerium.contributors.title')} <span>{contributors.length}</span></summary>
      <ul>
        {contributors.map((contributor) => {
          const roles = formatList(contributor.roles, locale);
          const segments = buildRoleSegments(contributor.roles);
          return (
            <li>
              <a
                href={contributor.url}
                target="_blank"
                rel="noreferrer"
                aria-label={t('viscerium.contributors.profileLabel', {
                  name: contributor.name,
                  roles,
                  interpolation: { escapeValue: false },
                })}
              >
                <span class="contributor-avatar-wrap">
                  {segments.length > 0 && (
                    <svg class="role-ring" viewBox="0 0 100 100" aria-hidden="true">
                      {segments.map((segment) => (
                        <circle
                          class:list={['segment', segment.className]}
                          cx="50"
                          cy="50"
                          r="46"
                          pathLength="100"
                          stroke-dasharray={segment.dasharray}
                          stroke-dashoffset={segment.dashoffset}
                          transform="rotate(-90 50 50)"
                        />
                      ))}
                    </svg>
                  )}
                  <img
                    src={contributor.avatarSrc}
                    alt=""
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="contributor-copy"><strong>{contributor.name}</strong><small>{roles}</small></span>
              </a>
            </li>
          );
        })}
      </ul>
    </details>
  </section>
)}

<style>
  .codex-contributors {
    --role-author: #d6b66a;
    --role-co-author: #c9896b;
    --role-editor: #8aa8c7;
    --role-research: #8faf98;
    --role-illustrator: #b59ac7;
    --role-consultant: #b9a894;
    --role-other: #8f969f;
    margin-block: 2.5rem 1.5rem;
    border-block-start: 1px solid var(--sl-color-hairline-light);
    padding: 1.5rem var(--sl-content-pad-x);
  }

  summary {
    cursor: pointer;
    color: var(--sl-color-white);
    font-size: var(--sl-text-lg);
    font-weight: 700;
  }

  summary span {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin: .85rem 0 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    gap: .65rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }

  a:hover strong {
    color: var(--sl-color-accent-high);
  }

  .contributor-avatar-wrap {
    position: relative;
    display: block;
    flex: 0 0 auto;
    width: 3.5rem;
    height: 3.5rem;
  }

  .role-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .role-ring .segment {
    fill: none;
    stroke-width: 6;
    stroke-linecap: round;
  }

  .role-ring .role-author { stroke: var(--role-author); }
  .role-ring .role-co-author { stroke: var(--role-co-author); }
  .role-ring .role-editor { stroke: var(--role-editor); }
  .role-ring .role-research { stroke: var(--role-research); }
  .role-ring .role-illustrator { stroke: var(--role-illustrator); }
  .role-ring .role-consultant { stroke: var(--role-consultant); }
  .role-ring .role-other { stroke: var(--role-other); }

  img {
    position: absolute;
    inset: .25rem;
    width: 3rem;
    height: 3rem;
    border: 2px solid var(--sl-color-bg);
    border-radius: 50%;
    background: var(--codex-surface-raised-color);
    object-fit: cover;
  }

  .contributor-copy {
    display: grid;
  }

  strong {
    color: var(--sl-color-white);
  }

  small {
    color: var(--sl-color-gray-3);
  }
</style>
