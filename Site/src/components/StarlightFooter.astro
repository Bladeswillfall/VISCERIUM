---
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import { classifyCodexPage } from '../lib/page-kind.mjs';
import ArticleDates from './ArticleDates.astro';
import CodexEditLink from './CodexEditLink.astro';
import ContributorStrip from './ContributorStrip.astro';
import ReferencedIn from './ReferencedIn.astro';

const { starlightRoute } = Astro.locals;
const pageKind = classifyCodexPage(starlightRoute.entry.data, starlightRoute.entry.id);
---

<div class="codex-page-deck">
  {pageKind.isStandardArticle && (
    <div class="codex-pagination" data-codex-pagination>
      <Pagination />
    </div>
  )}

  <ReferencedIn />
  {!pageKind.isEraHomepage && <ContributorStrip />}

  <div class="codex-site-footer sl-flex">
    <div class="meta sl-flex">
      <CodexEditLink />
      <ArticleDates />
    </div>
  </div>
</div>

<script>
  const tagRybbitPaginationLinks = () => {
    document.querySelectorAll('[data-codex-pagination] a[rel="prev"], [data-codex-pagination] a[rel="next"]').forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;
      const direction = link.rel === 'prev' ? 'previous' : 'next';
      link.dataset.rybbitEvent = 'article_pagination_click';
      link.dataset.rybbitPropDirection = direction;
      link.dataset.rybbitPropTarget = link.pathname;
    });
  };

  document.addEventListener('astro:page-load', tagRybbitPaginationLinks);
  tagRybbitPaginationLinks();
</script>

<style>
  /* On desktop, the sidebar stays hidden until the shell script sets its state. */
  @media (min-width: 800px) {
    :global(html:not([data-codex-desktop-sidebar]) #starlight__sidebar) {
      visibility: hidden;
      transform: translateX(-110%);
      opacity: 0;
      pointer-events: none;
    }
  }

  @layer starlight.core {
    :global(body:not(:has(.home-gateway)) .codex-main-pane > main) {
      padding-block-end: 0;
    }

    /*
      The reading handoff comes before reference and contributor metadata so the
      next article remains the primary action at the end of the article body.
    */
    .codex-page-deck {
      position: relative;
      z-index: 2;
      box-sizing: border-box;
      padding-block-end: 1.25rem;
      background: transparent;
    }

    .codex-pagination {
      margin-block: 2rem 2.75rem;
    }

    .codex-pagination :global(.pagination-links) {
      gap: .75rem;
    }

    .codex-pagination :global(.pagination-links a) {
      border-radius: 0;
      border-color: var(--sl-color-hairline-light);
      background: transparent;
      box-shadow: none;
    }

    .codex-pagination :global(.pagination-links a:hover),
    .codex-pagination :global(.pagination-links a:focus-visible) {
      border-color: var(--sl-color-accent-high);
    }

    .codex-site-footer {
      flex-direction: column;
      gap: 1.5rem;
      box-sizing: border-box;
      max-width: none;
    }

    .meta {
      gap: 0.75rem 3rem;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-top: 3rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }

    .meta > :global(p:only-child) {
      margin-inline-start: auto;
    }

    .codex-edit-link {
      color: var(--sl-color-gray-3);
      text-decoration: none;
    }

    .codex-edit-link:hover {
      color: var(--sl-color-accent-high);
      text-decoration: underline;
    }

    /* Era landing pages provide navigation and orientation. */
    :global(body:has(.codex-page-classifier--era-homepage) .codex-contributors) {
      display: none !important;
    }
  }
</style>
