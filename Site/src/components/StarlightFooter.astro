---
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import { classifyCodexPage } from '../lib/page-kind.mjs';
import CodexEditLink from './CodexEditLink.astro';
import ContributorStrip from './ContributorStrip.astro';
import ReferencedIn from './ReferencedIn.astro';
import Webmentions from './Webmentions.astro';

const { starlightRoute } = Astro.locals;
const pageKind = classifyCodexPage(starlightRoute.entry.data, starlightRoute.entry.id);
---

<div class="codex-page-deck">
  <ReferencedIn />
  {!pageKind.isEraHomepage && <ContributorStrip />}

  <div class="codex-site-footer sl-flex">
    <div class="meta sl-flex">
      <CodexEditLink />
      <LastUpdated />
    </div>
    {!pageKind.isEraHomepage && <Webmentions />}
    {!pageKind.isEraHomepage && <Pagination />}
  </div>
</div>

<style>
  /* Prevent an open-sidebar flash before the desktop runtime claims the shell. */
  @media (min-width: 800px) {
    :global(html:not([data-codex-desktop-sidebar]) #starlight__sidebar) {
      visibility: hidden;
      transform: translateX(-110%);
      opacity: 0;
      pointer-events: none;
    }
  }

  @layer starlight.core {
    :global(body:not(:has(.home-gateway)) .codex-main-pane > main) {
      padding-block-end: 0;
    }

    /*
      Referenced-in, contributor information, edit metadata, webmentions, and
      pagination remain in Starlight's article footer. The global navigation rail
      belongs to the PageFrame, so this wrapper no longer owns page-level reveal
      geometry.
    */
    .codex-page-deck {
      position: relative;
      z-index: 2;
      box-sizing: border-box;
      padding-block-end: 1.25rem;
      background: transparent;
    }

    .codex-site-footer {
      flex-direction: column;
      gap: 1.5rem;
      box-sizing: border-box;
      max-width: none;
    }

    .meta {
      gap: 0.75rem 3rem;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-top: 3rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }

    .meta > :global(p:only-child) {
      margin-inline-start: auto;
    }

    .codex-edit-link {
      color: var(--sl-color-gray-3);
      text-decoration: none;
    }

    .codex-edit-link:hover {
      color: var(--sl-color-accent-high);
      text-decoration: underline;
    }

    :global(giscus-comments) {
      display: block;
      padding: 1.5rem var(--sl-content-pad-x);
    }

    /* Era landing pages are navigation/orientation surfaces, not discussion articles. */
    :global(body:has(.codex-page-classifier--era-homepage) :is(
      .codex-contributors,
      .codex-webmentions,
      giscus-comments,
      .pagination-links
    )) {
      display: none !important;
    }
  }
</style>
