---
import '../styles/graph.css';

const { graph } = Astro.props;
const pages = graph.nodes.filter((node) => node.kind === 'page');
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="world-graph" data-world-graph data-graph-url={`${base}sitegraph/sitemap.json`}>
  <div class="world-graph__toolbar" aria-label="World Graph controls">
    <p><strong>{pages.length}</strong> public pages connected by internal links.</p>
    <button type="button" data-world-graph-reset disabled>Reset view</button>
  </div>
  <div class="world-graph__frame">
    <div
      class="world-graph__canvas"
      data-world-graph-canvas
      role="application"
      tabindex="0"
      aria-label="Interactive graph of public VISCERIUM pages. Use arrow keys to move between pages, Enter to select, and Escape to reset."
      aria-busy="true"
    ></div>
    <aside class="world-graph__details" data-world-graph-details aria-live="polite">
      <p>Select a page to inspect it.</p>
    </aside>
  </div>
  <p class="world-graph__status" data-world-graph-status role="status">Loading interactive graph…</p>
  <details class="world-graph__fallback" data-world-graph-fallback open>
    <summary>Browse all public pages</summary>
    <ul>
      {pages.map((page) => <li><a href={page.href}>{page.title}</a></li>)}
    </ul>
  </details>
</section>

<script>
  import cytoscape from 'cytoscape';

  const instances = new WeakMap<Element, () => void>();
  const interactionClasses = 'is-active is-distance-1 is-distance-2 is-distance-3 is-context is-muted';
  const readyStatus = 'Interactive graph ready. Use pointer or arrow keys to explore pages.';
  const pointerHitRadius = 18;
  const touchHitRadius = 24;
  const pointerHitPadding = 6;
  const dragThreshold = 5;
  const wheelSensitivity = .4;
  const maxWheelDelta = 120;
  const wheelZoomRate = .004;
  const wheelLinePixels = 32;
  const contextDepth = 3;
  const colourCanvas = document.createElement('canvas');
  colourCanvas.width = 1;
  colourCanvas.height = 1;
  const colourContext = colourCanvas.getContext('2d', { willReadFrequently: true });

  function clamp(value: number, minimum: number, maximum: number) {
    return Math.min(maximum, Math.max(minimum, value));
  }

  function normaliseWheel(event: WheelEvent, viewportHeight: number) {
    let delta = event.deltaY;
    if (!Number.isFinite(delta) || delta === 0) return 0;
    if (event.deltaMode === 1) delta *= wheelLinePixels;
    else if (event.deltaMode === 2) delta *= Math.max(viewportHeight, 1);
    return clamp(delta, -maxWheelDelta, maxWheelDelta);
  }

  function cytoscapeColour(value: string) {
    if (!value || !colourContext) return value;

    // Cytoscape 3.x does not parse modern CSS colour functions such as OKLCH.
    // Paint the browser-resolved colour into an sRGB canvas pixel, then hand
    // Cytoscape a legacy rgb()/rgba() string it can parse reliably.
    colourContext.clearRect(0, 0, 1, 1);
    colourContext.fillStyle = '#000';
    colourContext.fillStyle = value;
    colourContext.fillRect(0, 0, 1, 1);
    const [red, green, blue, alpha] = colourContext.getImageData(0, 0, 1, 1).data;
    if (alpha === 255) return `rgb(${red}, ${green}, ${blue})`;
    return `rgba(${red}, ${green}, ${blue}, ${(alpha / 255).toFixed(3)})`;
  }

  function colour(root: Element, name: string) {
    const probe = document.createElement('span');
    probe.style.color = `var(${name})`;
    root.append(probe);
    const value = getComputedStyle(probe).color;
    probe.remove();
    return cytoscapeColour(value);
  }

  function legacyGraphColour(root: Element, name: string) {
    return getComputedStyle(root).getPropertyValue(name).trim();
  }

  function labelStyle(root: Element, size: number, weight: number, opacity: number, marginY: number) {
    return {
      label: 'data(title)',
      color: legacyGraphColour(root, '--world-graph-cy-text'),
      'font-family': 'IBM Plex Sans, system-ui, sans-serif',
      'font-size': size,
      'font-weight': weight,
      'text-opacity': opacity,
      'text-margin-y': marginY,
      'text-events': 'no',
    };
  }

  function styles(root: Element) {
    return [
      {
        selector: 'node',
        style: {
          width: 14,
          height: 14,
          opacity: .82,
          'background-color': legacyGraphColour(root, '--world-graph-cy-node'),
          'border-color': legacyGraphColour(root, '--world-graph-cy-border'),
          'border-width': 1,
          'text-events': 'no',
          label: '',
        },
      },
      {
        selector: 'node[era = "citadel"]',
        style: {
          'background-color': colour(root, '--era-e1-accent'),
        },
      },
      {
        selector: 'node[era = "smog"]',
        style: {
          'background-color': colour(root, '--era-e2-accent'),
        },
      },
      {
        selector: 'node[era = "nearsight"]',
        style: {
          'background-color': colour(root, '--era-e3-accent'),
        },
      },
      {
        selector: 'node[era = "entropy"]',
        style: {
          'background-color': colour(root, '--era-e4-accent'),
        },
      },
      {
        selector: 'node.is-distance-3',
        style: {
          opacity: .48,
          ...labelStyle(root, 8, 500, .34, -11),
        },
      },
      {
        selector: 'node.is-distance-2',
        style: {
          width: 16,
          height: 16,
          opacity: .72,
          ...labelStyle(root, 9, 600, .58, -12),
        },
      },
      {
        selector: 'node.is-distance-1',
        style: {
          width: 19,
          height: 19,
          opacity: .96,
          ...labelStyle(root, 10.5, 700, .88, -14),
        },
      },
      {
        selector: 'node.is-active, node:selected',
        style: {
          width: 28,
          height: 28,
          opacity: 1,
          'border-color': legacyGraphColour(root, '--world-graph-cy-text'),
          'border-width': 2,
          'z-index': 10,
          ...labelStyle(root, 13, 800, 1, -18),
        },
      },
      {
        selector: 'node.is-muted',
        style: { opacity: .12 },
      },
      {
        selector: 'edge',
        style: {
          width: 1,
          'line-color': legacyGraphColour(root, '--world-graph-cy-edge'),
          opacity: Number(getComputedStyle(root).getPropertyValue('--world-graph-edge-opacity')),
          'curve-style': 'haystack',
        },
      },
      {
        selector: 'edge.is-context',
        style: {
          width: 1.35,
          opacity: .72,
        },
      },
      {
        selector: 'edge.is-muted',
        style: { opacity: .05 },
      },
    ];
  }

  function showPrompt(root: Element) {
    const details = root.querySelector('[data-world-graph-details]');
    if (!(details instanceof HTMLElement)) return;
    const prompt = document.createElement('p');
    prompt.textContent = 'Select a page to inspect it.';
    details.replaceChildren(prompt);
  }

  function showDetails(root: Element, node: any) {
    const details = root.querySelector('[data-world-graph-details]');
    if (!(details instanceof HTMLElement)) return;
    const data = node.data();
    const content = document.createElement('div');
    const title = document.createElement('h2');
    title.textContent = data.title;
    content.append(title);
    if (data.tags?.length) {
      const tags = document.createElement('p');
      tags.textContent = data.tags.map((tag: string) => `#${tag}`).join(', ');
      content.append(tags);
    }
    if (data.href) {
      const link = document.createElement('a');
      link.href = data.href;
      link.textContent = 'Open article';
      content.append(link);
    }
    details.replaceChildren(content);
  }

  function clearContext(cy: any, root: Element) {
    cy.elements().removeClass(interactionClasses);
    root.removeAttribute('data-world-graph-context');
    root.removeAttribute('data-world-graph-active-id');
    root.removeAttribute('data-world-graph-neighbour-count');
  }

  function contextDistances(node: any) {
    const distances = new Map<string, number>([[node.id(), 0]]);
    const queue = [node];

    for (let index = 0; index < queue.length; index += 1) {
      const current = queue[index];
      const distance = distances.get(current.id()) ?? 0;
      if (distance >= contextDepth) continue;

      current.neighborhood('node').forEach((neighbour: any) => {
        if (distances.has(neighbour.id())) return;
        distances.set(neighbour.id(), distance + 1);
        queue.push(neighbour);
      });
    }

    return distances;
  }

  function applyContext(cy: any, root: Element, node: any, source: string) {
    clearContext(cy, root);
    const distances = contextDistances(node);

    cy.nodes().addClass('is-muted');
    cy.edges().addClass('is-muted');

    for (const [nodeId, distance] of distances) {
      const related = cy.$id(nodeId);
      related.removeClass('is-muted');
      if (distance === 0) related.addClass('is-active');
      else related.addClass(`is-distance-${distance}`);
    }

    cy.edges().forEach((edge: any) => {
      if (!distances.has(edge.source().id()) || !distances.has(edge.target().id())) return;
      edge.removeClass('is-muted').addClass('is-context');
    });

    const neighbourCount = [...distances.values()].filter((distance) => distance === 1).length;
    root.setAttribute('data-world-graph-context', source);
    root.setAttribute('data-world-graph-active-id', node.id());
    root.setAttribute('data-world-graph-neighbour-count', String(neighbourCount));
  }

  async function mount(root: Element) {
    if (instances.has(root)) return;
    const canvas = root.querySelector('[data-world-graph-canvas]');
    const reset = root.querySelector<HTMLButtonElement>('[data-world-graph-reset]');
    const status = root.querySelector<HTMLElement>('[data-world-graph-status]');
    const fallback = root.querySelector<HTMLDetailsElement>('[data-world-graph-fallback]');
    if (!(canvas instanceof HTMLElement) || !root.getAttribute('data-graph-url')) return;

    try {
      const response = await fetch(root.getAttribute('data-graph-url')!, { signal: AbortSignal.timeout(10_000) });
      if (!response.ok) throw new Error(`World Graph data returned ${response.status}.`);
      const graph = await response.json();
      if (!root.isConnected) return;

      const pageNodes = graph.nodes.filter((node: any) => node.kind === 'page');
      const pageIds = new Set(pageNodes.map((node: any) => node.id));
      const pageEdges = graph.edges.filter((edge: any) => (
        edge.kind === 'link' && pageIds.has(edge.source) && pageIds.has(edge.target)
      ));
      const cy = cytoscape({
        container: canvas,
        elements: [
          ...pageNodes.map((node: any) => ({ data: node })),
          ...pageEdges.map((edge: any, index: number) => ({ data: { id: `edge:${index}`, ...edge } })),
        ],
        style: styles(root),
        minZoom: .12,
        maxZoom: 3.5,
        wheelSensitivity,
        boxSelectionEnabled: false,
        layout: {
          name: 'cose',
          animate: false,
          padding: 48,
          nodeRepulsion: 9_000,
          idealEdgeLength: 90,
          gravity: .18,
        },
      });

      const orderedNodes = cy.nodes().toArray().sort((left: any, right: any) => (
        String(left.data('title')).localeCompare(String(right.data('title')))
      ));
      let selectedNode: any = null;
      let keyboardNode: any = null;
      let pointerNode: any = null;
      let pointerGesture: null | {
        pointerId: number;
        pointerType: string;
        node: any;
        startX: number;
        startY: number;
        startPosition: { x: number; y: number };
        moved: boolean;
        intercepted: boolean;
      } = null;
      let touchGesture: null | {
        identifier: number;
        node: any;
        startX: number;
        startY: number;
        startPosition: { x: number; y: number };
        moved: boolean;
      } = null;

      const setStatus = (message: string) => {
        if (status) status.textContent = message;
      };
      const setZoomState = () => {
        root.setAttribute('data-world-graph-zoom', cy.zoom().toFixed(4));
      };
      const restoreContext = () => {
        if (selectedNode?.selected()) {
          applyContext(cy, root, selectedNode, 'selected');
        } else if (keyboardNode) {
          applyContext(cy, root, keyboardNode, 'keyboard');
        } else {
          clearContext(cy, root);
        }
      };
      const clearPointerContext = () => {
        pointerNode = null;
        canvas.style.removeProperty('cursor');
        restoreContext();
      };
      const setPointerContext = (node: any) => {
        if (!node) {
          clearPointerContext();
          return;
        }
        if (pointerNode?.id() === node.id() && root.getAttribute('data-world-graph-context') === 'pointer') return;
        pointerNode = node;
        canvas.style.cursor = 'pointer';
        applyContext(cy, root, node, 'pointer');
      };
      const selectNode = (node: any, source: string) => {
        cy.nodes().unselect();
        node.select();
        selectedNode = node;
        keyboardNode = node;
        pointerNode = null;
        applyContext(cy, root, node, source);
        showDetails(root, node);
        setStatus(`Selected ${node.data('title')}. Use Reset view to clear the selection.`);
      };
      const moveKeyboard = (nextIndex: number) => {
        if (!orderedNodes.length) return;
        cy.nodes().unselect();
        selectedNode = null;
        const wrappedIndex = ((nextIndex % orderedNodes.length) + orderedNodes.length) % orderedNodes.length;
        keyboardNode = orderedNodes[wrappedIndex];
        pointerNode = null;
        applyContext(cy, root, keyboardNode, 'keyboard');
        showDetails(root, keyboardNode);
        setStatus(`${keyboardNode.data('title')}. Use arrow keys to move, Enter to select, or Escape to reset.`);
      };
      const currentKeyboardIndex = () => (
        keyboardNode ? orderedNodes.findIndex((node: any) => node.id() === keyboardNode.id()) : -1
      );
      const handleReset = () => {
        cy.nodes().unselect();
        selectedNode = null;
        keyboardNode = null;
        pointerNode = null;
        pointerGesture = null;
        touchGesture = null;
        canvas.style.removeProperty('cursor');
        clearContext(cy, root);
        showPrompt(root);
        cy.fit(undefined, 48);
        setZoomState();
        setStatus(readyStatus);
      };
      const handleKeydown = (event: KeyboardEvent) => {
        if (event.altKey || event.ctrlKey || event.metaKey) return;
        const index = currentKeyboardIndex();
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          event.preventDefault();
          moveKeyboard(index < 0 ? 0 : index + 1);
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          event.preventDefault();
          moveKeyboard(index < 0 ? orderedNodes.length - 1 : index - 1);
        } else if (event.key === 'Home') {
          event.preventDefault();
          moveKeyboard(0);
        } else if (event.key === 'End') {
          event.preventDefault();
          moveKeyboard(orderedNodes.length - 1);
        } else if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          if (keyboardNode) selectNode(keyboardNode, 'selected');
        } else if (event.key === 'Escape') {
          event.preventDefault();
          handleReset();
        }
      };
      const handleFocus = () => {
        if (!orderedNodes.length) return;
        if (!keyboardNode) keyboardNode = selectedNode ?? orderedNodes[0];
        applyContext(cy, root, keyboardNode, selectedNode?.id() === keyboardNode.id() ? 'selected' : 'keyboard');
        showDetails(root, keyboardNode);
        setStatus(`${keyboardNode.data('title')}. Use arrow keys to move, Enter to select, or Escape to reset.`);
      };

      // The previous Pixi/D3 graph resolved pointer interactions from geometry rather
      // than from rendered labels. Do the same here so zoomed-out nodes retain a
      // forgiving, Obsidian-like interaction area without making the dots larger.
      const findNodeAt = (clientX: number, clientY: number, pointerType = 'mouse') => {
        const bounds = canvas.getBoundingClientRect();
        const x = clientX - bounds.left;
        const y = clientY - bounds.top;
        const minimumRadius = pointerType === 'touch' ? touchHitRadius : pointerHitRadius;
        const zoom = cy.zoom();
        let closest: any = null;
        let closestDistance = Number.POSITIVE_INFINITY;

        for (const node of orderedNodes) {
          const position = node.renderedPosition();
          const visualRadius = Math.max(node.width(), node.height()) * zoom / 2;
          const radius = Math.max(minimumRadius, visualRadius + pointerHitPadding);
          const distance = (position.x - x) ** 2 + (position.y - y) ** 2;
          if (distance <= radius ** 2 && distance < closestDistance) {
            closest = node;
            closestDistance = distance;
          }
        }
        return closest;
      };
      const findPointerNode = (event: PointerEvent) => findNodeAt(event.clientX, event.clientY, event.pointerType);

      const handleWheel = (event: WheelEvent) => {
        const target = event.target;
        if (!(target instanceof Node) || !canvas.contains(target)) return;
        const delta = normaliseWheel(event, canvas.clientHeight);
        if (delta === 0) return;

        // Claim the wheel event before Cytoscape's own capture listener. Only cancel
        // the browser's default scroll when the graph can actually consume the zoom,
        // so reaching a hard zoom bound does not trap the page.
        event.stopImmediatePropagation();
        if (pointerGesture || touchGesture) {
          event.preventDefault();
          return;
        }

        const bounds = canvas.getBoundingClientRect();
        const renderedPosition = {
          x: event.clientX - bounds.left,
          y: event.clientY - bounds.top,
        };
        const factor = Math.exp(-delta * wheelZoomRate * wheelSensitivity);
        const currentZoom = cy.zoom();
        const nextZoom = clamp(currentZoom * factor, cy.minZoom(), cy.maxZoom());
        if (Math.abs(nextZoom - currentZoom) < .000001) return;

        event.preventDefault();
        cy.zoom({ level: nextZoom, renderedPosition });
        setZoomState();
        setPointerContext(findNodeAt(event.clientX, event.clientY));
      };

      const handlePointerDown = (event: PointerEvent) => {
        if (event.pointerType === 'touch') return;
        if (event.button !== 0 || !event.isPrimary) return;
        const node = findPointerNode(event);
        if (!node) return;

        pointerGesture = {
          pointerId: event.pointerId,
          pointerType: event.pointerType,
          node,
          startX: event.clientX,
          startY: event.clientY,
          startPosition: { ...node.position() },
          moved: false,
          intercepted: true,
        };
        setPointerContext(node);
        canvas.setPointerCapture(event.pointerId);
        event.preventDefault();
        event.stopPropagation();
      };

      const handlePointerMove = (event: PointerEvent) => {
        if (event.pointerType === 'touch') return;
        if (pointerGesture?.pointerId === event.pointerId) {
          const dx = event.clientX - pointerGesture.startX;
          const dy = event.clientY - pointerGesture.startY;
          if (!pointerGesture.moved && Math.hypot(dx, dy) >= dragThreshold) pointerGesture.moved = true;

          if (pointerGesture.moved) {
            const zoom = Math.max(cy.zoom(), .0001);
            pointerGesture.node.position({
              x: pointerGesture.startPosition.x + dx / zoom,
              y: pointerGesture.startPosition.y + dy / zoom,
            });
            pointerNode = pointerGesture.node;
            canvas.style.cursor = 'grabbing';
            applyContext(cy, root, pointerGesture.node, 'pointer');
          }
          event.preventDefault();
          event.stopPropagation();
          return;
        }

        if (event.buttons) {
          clearPointerContext();
          return;
        }
        setPointerContext(findPointerNode(event));
      };

      const finishPointerGesture = (event: PointerEvent, cancelled = false) => {
        if (event.pointerType === 'touch') return;
        if (!pointerGesture || pointerGesture.pointerId !== event.pointerId) return;
        const gesture = pointerGesture;
        pointerGesture = null;

        if (canvas.hasPointerCapture(event.pointerId)) canvas.releasePointerCapture(event.pointerId);
        event.preventDefault();
        event.stopPropagation();

        if (!cancelled && !gesture.moved) {
          const releasedNode = findPointerNode(event);
          if (releasedNode?.id() === gesture.node.id()) {
            selectNode(gesture.node, 'selected');
            return;
          }
        }
        setPointerContext(findPointerNode(event));
      };

      const touchByIdentifier = (touches: TouchList, identifier: number) => (
        Array.from(touches).find((touch) => touch.identifier === identifier)
      );
      const handleTouchStart = (event: TouchEvent) => {
        const target = event.target;
        if (!(target instanceof Node) || !canvas.contains(target)) return;

        if (event.touches.length !== 1) {
          if (touchGesture) {
            touchGesture = null;
            clearPointerContext();
          }
          return;
        }

        const touch = event.touches[0];
        const node = findNodeAt(touch.clientX, touch.clientY, 'touch');
        if (!node) return;

        touchGesture = {
          identifier: touch.identifier,
          node,
          startX: touch.clientX,
          startY: touch.clientY,
          startPosition: { ...node.position() },
          moved: false,
        };
        setPointerContext(node);
        event.preventDefault();
        event.stopImmediatePropagation();
      };
      const handleTouchMove = (event: TouchEvent) => {
        if (!touchGesture) return;
        if (event.touches.length !== 1) {
          touchGesture = null;
          clearPointerContext();
          return;
        }

        const touch = touchByIdentifier(event.touches, touchGesture.identifier);
        if (!touch) return;
        const dx = touch.clientX - touchGesture.startX;
        const dy = touch.clientY - touchGesture.startY;
        if (!touchGesture.moved && Math.hypot(dx, dy) >= dragThreshold) touchGesture.moved = true;

        if (touchGesture.moved) {
          const zoom = Math.max(cy.zoom(), .0001);
          touchGesture.node.position({
            x: touchGesture.startPosition.x + dx / zoom,
            y: touchGesture.startPosition.y + dy / zoom,
          });
          pointerNode = touchGesture.node;
          applyContext(cy, root, touchGesture.node, 'pointer');
        }
        event.preventDefault();
        event.stopImmediatePropagation();
      };
      const finishTouchGesture = (event: TouchEvent, cancelled = false) => {
        if (!touchGesture) return;
        const gesture = touchGesture;
        const touch = touchByIdentifier(event.changedTouches, gesture.identifier);
        if (!touch) return;
        touchGesture = null;
        event.preventDefault();
        event.stopImmediatePropagation();

        if (!cancelled && !gesture.moved) {
          const releasedNode = findNodeAt(touch.clientX, touch.clientY, 'touch');
          if (releasedNode?.id() === gesture.node.id()) {
            selectNode(gesture.node, 'selected');
            return;
          }
        }
        clearPointerContext();
      };

      const handlePointerUp = (event: PointerEvent) => finishPointerGesture(event);
      const handlePointerCancel = (event: PointerEvent) => finishPointerGesture(event, true);
      const handleTouchEnd = (event: TouchEvent) => finishTouchGesture(event);
      const handleTouchCancel = (event: TouchEvent) => finishTouchGesture(event, true);
      const handlePointerLeave = () => {
        if (!pointerGesture) clearPointerContext();
      };
      const handleViewportMove = () => {
        setZoomState();
        if (!pointerGesture && !touchGesture && pointerNode) clearPointerContext();
      };

      reset?.addEventListener('click', handleReset);
      root.addEventListener('wheel', handleWheel, { passive: false, capture: true });
      root.addEventListener('touchstart', handleTouchStart, { passive: false, capture: true });
      root.addEventListener('touchmove', handleTouchMove, { passive: false, capture: true });
      root.addEventListener('touchend', handleTouchEnd, { passive: false, capture: true });
      root.addEventListener('touchcancel', handleTouchCancel, { passive: false, capture: true });
      canvas.addEventListener('pointerdown', handlePointerDown, true);
      canvas.addEventListener('pointermove', handlePointerMove, true);
      canvas.addEventListener('pointerup', handlePointerUp, true);
      canvas.addEventListener('pointercancel', handlePointerCancel, true);
      canvas.addEventListener('pointerleave', handlePointerLeave);
      canvas.addEventListener('keydown', handleKeydown);
      canvas.addEventListener('focus', handleFocus);
      cy.on('pan zoom', handleViewportMove);
      setZoomState();
      if (reset) reset.disabled = false;
      canvas.setAttribute('aria-busy', 'false');
      root.setAttribute('data-world-graph-ready', 'true');
      setStatus(readyStatus);
      if (fallback) fallback.open = false;

      const resizeObserver = new ResizeObserver(() => cy.resize());
      resizeObserver.observe(canvas);
      const themeObserver = new MutationObserver(() => cy.style(styles(root)));
      themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      instances.set(root, () => {
        resizeObserver.disconnect();
        themeObserver.disconnect();
        reset?.removeEventListener('click', handleReset);
        root.removeEventListener('wheel', handleWheel, true);
        root.removeEventListener('touchstart', handleTouchStart, true);
        root.removeEventListener('touchmove', handleTouchMove, true);
        root.removeEventListener('touchend', handleTouchEnd, true);
        root.removeEventListener('touchcancel', handleTouchCancel, true);
        canvas.removeEventListener('pointerdown', handlePointerDown, true);
        canvas.removeEventListener('pointermove', handlePointerMove, true);
        canvas.removeEventListener('pointerup', handlePointerUp, true);
        canvas.removeEventListener('pointercancel', handlePointerCancel, true);
        canvas.removeEventListener('pointerleave', handlePointerLeave);
        canvas.removeEventListener('keydown', handleKeydown);
        canvas.removeEventListener('focus', handleFocus);
        cy.off('pan zoom', handleViewportMove);
        cy.destroy();
      });
    } catch (error) {
      console.error(error);
      canvas.setAttribute('aria-busy', 'false');
      if (status) status.textContent = 'The interactive graph is unavailable. Use the page list below.';
    }
  }

  function mountAll() {
    document.querySelectorAll('[data-world-graph]').forEach((root) => void mount(root));
  }

  mountAll();
  document.addEventListener('astro:page-load', mountAll);
  document.addEventListener('astro:before-swap', () => {
    document.querySelectorAll('[data-world-graph]').forEach((root) => {
      instances.get(root)?.();
      instances.delete(root);
    });
  });
</script>
