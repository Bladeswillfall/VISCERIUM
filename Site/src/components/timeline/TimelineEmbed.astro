---
import TimelineApp from './TimelineApp.astro';

type TimelineDataset = {
  defaultCalendar?: string;
  title: string;
  description: string;
  events: unknown[];
  [key: string]: unknown;
};

type Props = {
  timelineId: string;
  defaultCalendar?: string;
  laneMode?: 'unified' | 'lane' | 'category';
  showFilters?: boolean;
  showMinimap?: boolean;
  showLegend?: boolean;
  compact?: boolean;
};

const {
  timelineId,
  defaultCalendar,
  laneMode = 'unified',
  showFilters = true,
  showMinimap = true,
  showLegend = true,
  compact = false,
} = Astro.props as Props;

const datasets = import.meta.glob('../../data/timelines/{super,citadel,smog,nearsight,entropy}.json', {
  eager: true,
  import: 'default',
});
const dataset = (datasets as Record<string, TimelineDataset>)[`../../data/timelines/${timelineId}.json`];
---

{dataset ? (
  <TimelineApp
    dataset={dataset}
    defaultCalendar={defaultCalendar ?? dataset.defaultCalendar}
    laneMode={laneMode}
    showFilters={showFilters}
    showMinimap={showMinimap}
    showLegend={showLegend}
    compact={compact}
  />
) : <p class="codex-warning">Unknown timeline: <code>{timelineId}</code>.</p>}
