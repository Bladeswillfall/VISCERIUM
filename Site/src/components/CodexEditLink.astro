---
import siteConfig from '../../site.config.mjs';

const { starlightRoute } = Astro.locals;
const { t } = Astro.locals;
const { label = t('page.editLink') } = Astro.props;
const sourcePath = starlightRoute.entry.data.sourcePath;
const sourceRepoPath = starlightRoute.entry.data.sourceRepoPath
  ?? (typeof sourcePath === 'string' ? `Vault/Lore/${sourcePath}` : undefined);
const encodedSourcePath = typeof sourceRepoPath === 'string'
  ? sourceRepoPath.split('/').map((segment) => encodeURIComponent(segment)).join('/')
  : undefined;
const editUrl = siteConfig.githubRepoUrl && encodedSourcePath
  ? `${siteConfig.githubRepoUrl}/edit/main/${encodedSourcePath}`
  : undefined;
---

{editUrl && (
  <a class="codex-edit-link" href={editUrl} target="_blank" rel="noreferrer">
    {label}<span class="codex-sr-only">{t('viscerium.common.newTab')}</span>
  </a>
)}
