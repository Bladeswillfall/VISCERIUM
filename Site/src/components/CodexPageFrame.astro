---
import DefaultPageFrame from '@astrojs/starlight/components/PageFrame.astro';
import { classifyCodexPage } from '../lib/page-kind.mjs';
import CodexDiscussions from './CodexDiscussions.astro';
import CodexFooterRail from './CodexFooterRail.astro';

const { starlightRoute } = Astro.locals;
const entry = starlightRoute.entry.data;
const pageKind = classifyCodexPage(entry, starlightRoute.entry.id);
---

<span
  class:list={{
    'codex-page-classifier': true,
    'codex-page-classifier--structural': pageKind.isStructural,
    'codex-page-classifier--article': pageKind.isStandardArticle,
    'codex-page-classifier--homepage': pageKind.isHomepage,
    'codex-page-classifier--era-homepage': pageKind.isEraHomepage,
  }}
  hidden
  aria-hidden="true"
></span>

<DefaultPageFrame>
  <slot name="header" slot="header" />
  <slot name="sidebar" slot="sidebar" />
  <slot />
</DefaultPageFrame>

<CodexDiscussions />
<CodexFooterRail />

<script>
  const TOOLTIP_SELECTOR = '[data-smart-tooltip]';
  const TOOLTIP_STYLE_ID = 'viscerium-smart-tooltip-styles';
  const globalWindow = window as typeof window & {
    __visceriumSmartTooltipCleanup?: () => void;
    __visceriumSmartTooltipLoadVersion?: number;
    __visceriumSmartTooltipRuntimeInstalled?: boolean;
  };

  const cleanupSmartTooltips = () => {
    globalWindow.__visceriumSmartTooltipCleanup?.();
    globalWindow.__visceriumSmartTooltipCleanup = undefined;
  };

  const ensureSmartTooltipStyles = (css: string) => {
    if (document.getElementById(TOOLTIP_STYLE_ID)) return;
    const style = document.createElement('style');
    style.id = TOOLTIP_STYLE_ID;
    style.textContent = css;
    document.head.append(style);
  };

  const syncSmartTooltips = async () => {
    const loadVersion = (globalWindow.__visceriumSmartTooltipLoadVersion ?? 0) + 1;
    globalWindow.__visceriumSmartTooltipLoadVersion = loadVersion;
    cleanupSmartTooltips();

    if (!document.querySelector(TOOLTIP_SELECTOR)) return;

    const [{ installSmartTooltips }, styleModule] = await Promise.all([
      import('../lib/ui/smart-tooltips.mjs'),
      import('../styles/smart-tooltips.css?raw'),
    ]);

    if (globalWindow.__visceriumSmartTooltipLoadVersion !== loadVersion) return;
    if (!document.querySelector(TOOLTIP_SELECTOR)) return;

    ensureSmartTooltipStyles(styleModule.default);
    globalWindow.__visceriumSmartTooltipCleanup = installSmartTooltips(document);
  };

  if (!globalWindow.__visceriumSmartTooltipRuntimeInstalled) {
    globalWindow.__visceriumSmartTooltipRuntimeInstalled = true;
    document.addEventListener('astro:page-load', () => void syncSmartTooltips());
    document.addEventListener('astro:before-swap', () => {
      globalWindow.__visceriumSmartTooltipLoadVersion = (globalWindow.__visceriumSmartTooltipLoadVersion ?? 0) + 1;
      cleanupSmartTooltips();
    });
  }

  void syncSmartTooltips();
</script>


<script>
  const ARTIFACT_SELECTOR = '.cx-artifact[data-preset]';
  const ARTIFACT_STYLE_ID = 'viscerium-artifact-styles';
  const ARTIFACT_FONT_ID = 'viscerium-artifact-fonts';
  const artifactWindow = window as typeof window & {
    __visceriumArtifactsCleanup?: () => void;
    __visceriumArtifactsLoad?: number;
    __visceriumArtifactsInstalled?: boolean;
  };

  const syncArtifacts = async () => {
    const generation = (artifactWindow.__visceriumArtifactsLoad ?? 0) + 1;
    artifactWindow.__visceriumArtifactsLoad = generation;
    artifactWindow.__visceriumArtifactsCleanup?.();
    artifactWindow.__visceriumArtifactsCleanup = undefined;
    if (!document.querySelector(ARTIFACT_SELECTOR)) return;

    const [{ installArtifactDocuments }, { default: css }] = await Promise.all([
      import('../lib/ui/artifact-documents.mjs'),
      import('../styles/artifact-documents.css?raw'),
    ]);
    if (artifactWindow.__visceriumArtifactsLoad !== generation) return;

    if (!document.getElementById(ARTIFACT_STYLE_ID)) {
      const style = document.createElement('style');
      style.id = ARTIFACT_STYLE_ID;
      style.textContent = css;
      document.head.append(style);
    }
    if (document.querySelector('.cx-artifact[data-preset="citadel-note"]')
      && !document.getElementById(ARTIFACT_FONT_ID)) {
      const link = document.createElement('link');
      link.id = ARTIFACT_FONT_ID;
      link.rel = 'stylesheet';
      link.href = 'https://fonts.googleapis.com/css2?family=Fondamento:ital@0;1&family=IM+Fell+English:ital@0;1&family=Jim+Nightshade&display=swap';
      document.head.append(link);
    }
    artifactWindow.__visceriumArtifactsCleanup = installArtifactDocuments(document);
  };

  if (!artifactWindow.__visceriumArtifactsInstalled) {
    artifactWindow.__visceriumArtifactsInstalled = true;
    document.addEventListener('astro:page-load', () => void syncArtifacts());
    document.addEventListener('astro:before-swap', () => {
      artifactWindow.__visceriumArtifactsLoad = (artifactWindow.__visceriumArtifactsLoad ?? 0) + 1;
      artifactWindow.__visceriumArtifactsCleanup?.();
      artifactWindow.__visceriumArtifactsCleanup = undefined;
    });
  }
  void syncArtifacts();
</script>

<style is:global>
  @layer ion {
    /*
     * The page-level navigation rail sits behind the main page.
     * `body` sets the local layer order.
     * This places the rail above the body background and below the Starlight page.
     */
    body {
      position: relative;
      isolation: isolate;
    }

    .page {
      position: relative;
      z-index: var(--codex-z-page, 0);
      background: var(--codex-page-bg);
      box-shadow:
        0 1.5rem 3.4375rem color-mix(in oklch, var(--codex-shadow-color) 46%, transparent),
        0 1px 0 var(--sl-color-hairline-light);
    }

    @media print, (forced-colors: active) {
      .page {
        box-shadow: none;
      }
    }
  }
</style>
