---
import { getCollection } from 'astro:content';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { getHomeShellTranslationForPath } from '../lib/home-i18n.mjs';
import CodexIcon from './CodexIcon.astro';

const { t } = Astro.locals;
const homeSettings = getHomeShellTranslationForPath(Astro.url.pathname)?.settings;
const docs = await getCollection('docs');
const sensitiveMediaManifest = docs.flatMap((doc) => {
  const asset = typeof doc.data.asset === 'string' ? doc.data.asset.trim() : '';
  const warnings = Array.isArray(doc.data.contentWarnings) ? doc.data.contentWarnings : [];
  if (doc.data.type !== 'image' || !asset || (doc.data.sensitiveMedia !== true && warnings.length === 0)) return [];
  return [{
    asset,
    sensitive: doc.data.sensitiveMedia === true,
    warnings,
  }];
});
const sensitiveMediaManifestJson = JSON.stringify(sensitiveMediaManifest).replace(/</g, '\\u003c');
---

<viscerium-reader-settings
  class="reader-settings"
  data-sensitive-reveal-label={homeSettings?.revealImage ?? t('viscerium.settings.revealImage')}
  data-sensitive-warning-label={homeSettings?.sensitiveImage ?? t('viscerium.settings.sensitiveImage')}
>
  <button
    class="reader-settings-trigger"
    type="button"
    aria-expanded="false"
    aria-controls="reader-settings-panel"
    aria-label={homeSettings?.open ?? t('viscerium.settings.open')}
    title={homeSettings?.open ?? t('viscerium.settings.open')}
    data-reader-settings-trigger
  >
    <CodexIcon spec="settings" />
  </button>

  <div
    class="reader-settings-panel"
    id="reader-settings-panel"
    role="dialog"
    aria-labelledby="reader-settings-title"
    hidden
    data-reader-settings-panel
  >
    <div class="reader-settings-heading">
      <div>
        <p class="reader-settings-kicker">{homeSettings?.kicker ?? t('viscerium.settings.kicker')}</p>
        <h2 id="reader-settings-title">{homeSettings?.title ?? t('viscerium.settings.title')}</h2>
      </div>
      <button
        class="reader-settings-close"
        type="button"
        aria-label={homeSettings?.close ?? t('viscerium.settings.close')}
        data-reader-settings-close
      >
        <CodexIcon spec="close" />
      </button>
    </div>

    <fieldset class="reader-settings-section" data-reader-theme-group>
      <legend>
        <CodexIcon spec="palette" class="reader-settings-section-icon" />
        <span>{homeSettings?.appearance ?? t('viscerium.settings.appearance')}</span>
      </legend>
      <div class="reader-theme-options">
        <label>
          <input type="radio" name="reader-theme" value="auto" data-reader-theme-option />
          <span>
            <CodexIcon spec="desktop" />
            <span>{homeSettings?.auto ?? t('themeSelect.auto')}</span>
          </span>
        </label>
        <label>
          <input type="radio" name="reader-theme" value="light" data-reader-theme-option />
          <span>
            <CodexIcon spec="light-mode" />
            <span>{homeSettings?.light ?? t('themeSelect.light')}</span>
          </span>
        </label>
        <label>
          <input type="radio" name="reader-theme" value="dark" data-reader-theme-option />
          <span>
            <CodexIcon spec="dark-mode" />
            <span>{homeSettings?.dark ?? t('themeSelect.dark')}</span>
          </span>
        </label>
      </div>
      <div class="reader-theme-bridge" aria-hidden="true">
        <ThemeSelect />
      </div>
    </fieldset>

    <fieldset class="reader-settings-section">
      <legend>
        <CodexIcon spec="visibility" class="reader-settings-section-icon" />
        <span>{homeSettings?.content ?? t('viscerium.settings.content')}</span>
      </legend>
      <label class="reader-settings-switch-row">
        <span>
          <strong>{homeSettings?.concealSensitive ?? t('viscerium.settings.concealSensitive')}</strong>
          <small>{homeSettings?.concealSensitiveDescription ?? 'Blurs marked artwork until you reveal it.'}</small>
        </span>
        <input
          type="checkbox"
          role="switch"
          aria-label={homeSettings?.concealSensitive ?? t('viscerium.settings.concealSensitive')}
          data-reader-sensitive-toggle
        />
        <span class="reader-settings-switch" aria-hidden="true"></span>
      </label>
      <p class="reader-settings-note">{homeSettings?.contentNote ?? 'VISCERIUM is written for mature audiences. This setting only changes how marked images are shown.'}</p>
    </fieldset>
  </div>

  <template data-sensitive-media-manifest>{sensitiveMediaManifestJson}</template>
</viscerium-reader-settings>

<script>
  import '../scripts/reader-settings.js';
</script>
