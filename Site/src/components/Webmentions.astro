---
import siteConfig from '../../site.config.mjs';

const config = siteConfig.webmentions;
const enabled = Boolean(config?.enabled && config.apiEndpoint);
const { t } = Astro.locals;
const messages = {
  none: t('viscerium.webmentions.none'),
  unavailable: t('viscerium.webmentions.unavailable'),
  responses: Object.fromEntries(
    ['zero', 'one', 'two', 'few', 'many', 'other']
      .map((category) => [category, t(`viscerium.webmentions.responses.${category}`)]),
  ),
  someone: t('viscerium.webmentions.someone'),
  on: t('viscerium.webmentions.on'),
  viewSource: t('viscerium.webmentions.viewSource'),
  actions: {
    like: t('viscerium.webmentions.action.like'),
    repost: t('viscerium.webmentions.action.repost'),
    bookmark: t('viscerium.webmentions.action.bookmark'),
    reply: t('viscerium.webmentions.action.reply'),
    mention: t('viscerium.webmentions.action.mention'),
    other: t('viscerium.webmentions.action.other'),
  },
};
---

{enabled && (
  <codex-webmentions
    class="codex-webmentions"
    data-api={config.apiEndpoint}
    data-limit={config.maxMentions}
    data-messages={JSON.stringify(messages)}
  >
    <details open>
      <summary>
        <span class="codex-webmentions__summary-row">
          <span>{t('viscerium.webmentions.title')}</span>
          <a
            class="codex-webmentions__provider"
            href="https://webmention.io/"
            target="_blank"
            rel="noreferrer"
            aria-label={`Webmention.io${t('viscerium.common.newTab')}`}
            title="Webmention.io"
          >
            <img
              src="/assets/services/webmention-io.webp"
              alt=""
              width="128"
              height="128"
              loading="lazy"
              decoding="async"
            />
          </a>
        </span>
      </summary>
      <p data-state role="status">{t('viscerium.webmentions.loading')}</p>
      <div class="codex-webmention-list" data-list></div>
    </details>
  </codex-webmentions>
)}

<style>
  .codex-webmentions {
    display: block;
    margin-block: 2rem;
    border-block-start: 1px solid var(--sl-color-hairline-light);
    padding-block-start: 1rem;
  }

  summary {
    cursor: pointer;
    color: var(--sl-color-white);
    font-weight: 700;
  }

  .codex-webmentions__summary-row {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
  }

  .codex-webmentions__provider {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: 1.3rem;
    block-size: 1.3rem;
    border-radius: .2rem;
    opacity: .55;
    filter: brightness(.9);
    transition: opacity 160ms ease, filter 160ms ease;
  }

  .codex-webmentions__provider:hover,
  .codex-webmentions__provider:focus-visible {
    opacity: 1;
    filter: brightness(1.25);
  }

  .codex-webmentions__provider:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: .18rem;
  }

  .codex-webmentions__provider img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  [data-state] {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .codex-webmention-list {
    display: grid;
    gap: .75rem;
  }

  article {
    padding-block: .75rem;
    border-block-start: 1px solid var(--sl-color-hairline-light);
  }

  article p {
    margin-block: 0 .4rem;
  }

  article a {
    overflow-wrap: anywhere;
  }

  @media (prefers-reduced-motion: reduce) {
    .codex-webmentions__provider {
      transition: none;
    }
  }

  @media print, (forced-colors: active) {
    .codex-webmentions__provider {
      opacity: 1;
      filter: none;
    }
  }
</style>
