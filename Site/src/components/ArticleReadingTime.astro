---
import { getCollection } from 'astro:content';
import { normalisePageSlug } from '../lib/page-kind.mjs';
import { estimateReadingTime, isReadingTimeArticle } from '../lib/reading-time.mjs';

const { starlightRoute } = Astro.locals;
const { t } = Astro.locals;
const entry = starlightRoute.entry.data;
const fallbackId = starlightRoute.entry.id;
const targetSlug = normalisePageSlug(entry.slug ?? fallbackId);
const docs = await getCollection('docs');
const sourceEntry = docs.find((doc) => doc.id === fallbackId)
  ?? docs.find((doc) => normalisePageSlug(doc.data.slug ?? doc.id) === targetSlug);
const readingTime = isReadingTimeArticle(entry, fallbackId) && sourceEntry?.body
  ? estimateReadingTime(sourceEntry.body)
  : null;
---

{readingTime && (
  <p
    class="codex-reading-time"
    data-reading-time
    aria-label={t('viscerium.article.readingTimeLabel', { count: readingTime.minutes })}
  >
    {t('viscerium.article.readingTime', { count: readingTime.minutes })}
  </p>
)}

<style>
  .codex-reading-time {
    margin: .32rem 0 .72rem;
    color: var(--sl-color-gray-4);
    font-family: var(--vc-font-ui);
    font-size: .72rem;
    font-weight: 500;
    letter-spacing: .025em;
    line-height: 1.25;
  }
</style>
