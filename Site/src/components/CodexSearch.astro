---
import { Icon } from '@astrojs/starlight/components';

const { t } = Astro.locals;
---

<button
  class="codex-search-trigger"
  type="button"
  data-codex-search-open
  data-open-modal
  aria-haspopup="dialog"
  aria-controls="telescope-dialog"
  aria-keyshortcuts="Control+K"
  disabled
>
  <Icon name="magnifier" />
  <span>{t('search.label')}</span>
  <kbd>{t('search.ctrlKey')} K</kbd>
</button>

<style>
  .codex-search-trigger {
    display: inline-flex;
    align-items: center;
    width: 100%;
    gap: .45rem;
    min-height: 2.2rem;
    padding: .4rem .7rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: .55rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .codex-search-trigger:hover { color: var(--sl-color-white); border-color: var(--sl-color-gray-4); }
  .codex-search-trigger kbd { color: var(--sl-color-gray-3); font-size: .7rem; }
  @media (max-width: 34rem) { .codex-search-trigger kbd { display: none; } }
</style>
