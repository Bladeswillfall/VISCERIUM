---
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
---

<LanguageSelect />

<style is:global>
  .codex-header-controls starlight-lang-select {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 2.5rem;
  }

  .codex-header-controls starlight-lang-select label {
    position: relative;
    display: inline-grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    background: var(--sl-color-bg-nav, var(--sl-color-black));
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }

  .codex-header-controls starlight-lang-select label::before {
    content: '';
    width: 1.15rem;
    height: 1.15rem;
    background: currentColor;
    -webkit-mask: url('/icons/i18n.svg') center / contain no-repeat;
    mask: url('/icons/i18n.svg') center / contain no-repeat;
    pointer-events: none;
  }

  .codex-header-controls starlight-lang-select label:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .codex-header-controls starlight-lang-select .label-icon,
  .codex-header-controls starlight-lang-select .caret {
    display: none;
  }

  .codex-header-controls starlight-lang-select select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: pointer;
  }

  .codex-header-controls starlight-lang-select label:focus-within {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }
</style>
