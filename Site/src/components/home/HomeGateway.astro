---
import CodexLanguageMenu from '../CodexLanguageMenu.astro';
import { HOME_LANGUAGES, getHomeTranslation, homepageHref } from '../../lib/home-i18n.mjs';
import RecentArticles from './RecentArticles.astro';

interface Props {
  locale?: string;
}

const { locale = 'en-GB' } = Astro.props;
const copy = getHomeTranslation(locale);
const languageOptions = HOME_LANGUAGES.map((language) => ({
  locale: language.locale,
  href: homepageHref(language.route),
  nativeLabel: language.nativeLabel,
  secondaryLabel: language.locale === 'en-GB' ? undefined : language.englishLabel,
  secondaryLang: language.locale === 'en-GB' ? undefined : 'en-GB',
  flag: language.flag,
  current: language.locale === locale,
}));
---

<div class="home-gateway" id="home-gateway-top">
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero__copy">
      <p class="home-eyebrow">{copy.hero.eyebrow}</p>
      <h1 id="home-hero-title">VISCERIUM</h1>
      <p class="home-hero__deck">{copy.hero.deck}</p>
      <div class="home-actions">
        <a
          class="home-button"
          href="/start-here/"
          data-rybbit-event="home_start_click"
          data-rybbit-prop-placement="hero"
        >{copy.hero.start}</a>
        <a
          class="home-button home-button--secondary"
          href="#home-era-gateway"
          data-rybbit-event="home_era_prompt_click"
        >{copy.hero.explore}</a>
      </div>
      <div class="home-language-switcher">
        <CodexLanguageMenu
          triggerLabel={copy.languageMenu.trigger}
          panelLabel={copy.languageMenu.panel}
          options={languageOptions}
        />
      </div>
    </div>

    <p class="home-era-scroll-hint" aria-hidden="true">
      <span>{copy.hero.scrollHint}</span>
      <span>I → IV</span>
    </p>

    <ol
      class="home-era-gateway"
      id="home-era-gateway"
      aria-label={copy.hero.erasLabel}
      tabindex="0"
    >
      <li>
        <a
          class="home-era-card home-era-card--citadel"
          href="/eras/citadel/"
          aria-describedby="home-citadel-description"
          data-rybbit-event="home_era_click"
          data-rybbit-prop-era="CITADEL"
        >
          <div class="home-era-card__content">
            <span class="home-era-card__number">{copy.eras[0].number}</span>
            <h2>CITADEL</h2>
            <p class="home-era-card__tags">{copy.eras[0].tags}</p>
            <p class="home-era-card__description" id="home-citadel-description">{copy.eras[0].description}</p>
            <span class="home-era-card__action">{copy.eras[0].action}</span>
          </div>
        </a>
      </li>
      <li>
        <a
          class="home-era-card home-era-card--smog"
          href="/eras/smog/"
          aria-describedby="home-smog-description"
          data-rybbit-event="home_era_click"
          data-rybbit-prop-era="SMOG"
        >
          <div class="home-era-card__content">
            <span class="home-era-card__number">{copy.eras[1].number}</span>
            <h2>SMOG</h2>
            <p class="home-era-card__tags">{copy.eras[1].tags}</p>
            <p class="home-era-card__description" id="home-smog-description">{copy.eras[1].description}</p>
            <span class="home-era-card__action">{copy.eras[1].action}</span>
          </div>
        </a>
      </li>
      <li>
        <a
          class="home-era-card home-era-card--nearsight"
          href="/eras/nearsight/"
          aria-describedby="home-nearsight-description"
          data-rybbit-event="home_era_click"
          data-rybbit-prop-era="NEARSIGHT"
        >
          <div class="home-era-card__content">
            <span class="home-era-card__number">{copy.eras[2].number}</span>
            <h2>NEARSIGHT</h2>
            <p class="home-era-card__tags">{copy.eras[2].tags}</p>
            <p class="home-era-card__description" id="home-nearsight-description">{copy.eras[2].description}</p>
            <span class="home-era-card__action">{copy.eras[2].action}</span>
          </div>
        </a>
      </li>
      <li>
        <a
          class="home-era-card home-era-card--entropy"
          href="/eras/entropy/"
          aria-describedby="home-entropy-description"
          data-rybbit-event="home_era_click"
          data-rybbit-prop-era="ENTROPY"
        >
          <div class="home-era-card__content">
            <span class="home-era-card__number">{copy.eras[3].number}</span>
            <h2>ENTROPY</h2>
            <p class="home-era-card__tags">{copy.eras[3].tags}</p>
            <p class="home-era-card__description" id="home-entropy-description">{copy.eras[3].description}</p>
            <span class="home-era-card__action">{copy.eras[3].action}</span>
          </div>
        </a>
      </li>
    </ol>
  </section>

  <section class="home-section" id="home-routes" aria-labelledby="home-routes-title">
    <header class="home-section__intro">
      <p class="home-eyebrow">{copy.routes.eyebrow}</p>
      <h2 class="home-section__heading" id="home-routes-title">{copy.routes.heading}</h2>
      <p class="home-lead">{copy.routes.lead}</p>
    </header>

    <div class="home-route-grid">
      <a
        class="home-route-card"
        href="/start-here/"
        data-rybbit-event="home_route_click"
        data-rybbit-prop-target="start-here"
      >
        <span class="home-route-card__symbol" aria-hidden="true">Ⅰ</span>
        <h3>{copy.routes.cards[0].title}</h3>
        <p>{copy.routes.cards[0].description}</p>
        <strong>{copy.routes.cards[0].action}</strong>
      </a>
      <a
        class="home-route-card"
        href="/degel-system/"
        data-rybbit-event="home_route_click"
        data-rybbit-prop-target="degel-system"
      >
        <span class="home-route-card__symbol" aria-hidden="true">⌁</span>
        <h3>{copy.routes.cards[1].title}</h3>
        <p>{copy.routes.cards[1].description}</p>
        <strong>{copy.routes.cards[1].action}</strong>
      </a>
      <a
        class="home-route-card"
        href="/timelines/super/"
        data-rybbit-event="home_route_click"
        data-rybbit-prop-target="timeline"
      >
        <span class="home-route-card__symbol" aria-hidden="true">✣</span>
        <h3>{copy.routes.cards[2].title}</h3>
        <p>{copy.routes.cards[2].description}</p>
        <strong>{copy.routes.cards[2].action}</strong>
      </a>
    </div>
  </section>

  <section class="home-section" id="home-continuum" aria-labelledby="home-continuum-title">
    <div class="home-section__grid">
      <header>
        <p class="home-eyebrow">{copy.continuum.eyebrow}</p>
        <h2 class="home-section__heading" id="home-continuum-title">{copy.continuum.heading}</h2>
        <p class="home-lead">{copy.continuum.lead}</p>
      </header>
      <div class="home-body-copy">
        <p>{copy.continuum.body[0]}</p>
        <p>{copy.continuum.body[1]}</p>
      </div>
    </div>
  </section>
  <RecentArticles locale={locale} copy={copy.recent} />
</div>

<style is:inline>
  .home-language-switcher {
    display: flex;
    justify-content: center;
    margin-block-start: 1rem;
  }
</style>
