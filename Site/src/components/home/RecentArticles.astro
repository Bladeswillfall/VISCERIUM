---
import { getCollection } from 'astro:content';
import { getRecentArticles } from '../../lib/recent-articles.mjs';

const formatter = new Intl.DateTimeFormat(Astro.currentLocale ?? 'en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});
const marks = { CITADEL: 'I', SMOG: 'II', NEARSIGHT: 'III', ENTROPY: 'IV', Universal: '✦' };
const articles = getRecentArticles(await getCollection('docs')).map((article, index) => ({
  ...article,
  ordinal: String(index + 1).padStart(2, '0'),
  eraMark: marks[article.era],
  eraClass: `record--${article.era.toLowerCase()}`,
}));
---

{articles.length > 0 && (
<section class="recent" id="recent-articles" data-view="rail" aria-labelledby="recent-title" aria-describedby="recent-intro">
      <div class="recent__inner">
        <header class="recent__top">
          <div>
            <h2 class="recent__title" id="recent-title">Recent articles</h2>
            <p class="recent__intro" id="recent-intro">New entries and revised records from across the VISCERIUM Codex.</p>
          </div>
          <div class="recent__tools">
            <p class="recent__count">{String(articles.length).padStart(2, '0')} ARTICLES</p>
            <div class="recent__actions">
              <button class="recent__view" id="recent-toggle" type="button" aria-controls="recent-track" aria-expanded="false" hidden>
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><rect x="1.5" y="1.5" width="7" height="7"/><rect x="11.5" y="1.5" width="7" height="7"/><rect x="1.5" y="11.5" width="7" height="7"/><rect x="11.5" y="11.5" width="7" height="7"/></svg>
                <span id="recent-toggle-text">Expand to grid</span>
              </button>
              <div class="recent__controls" role="group" aria-label="Article carousel navigation">
                <button class="recent__arrow" id="recent-prev" type="button" aria-label="Scroll to previous article" aria-controls="recent-track" hidden>←</button>
                <button class="recent__arrow" id="recent-next" type="button" aria-label="Scroll to next article" aria-controls="recent-track" hidden>→</button>
              </div>
            </div>
          </div>
        </header>
        <ol class="recent__track" id="recent-track" tabindex="-1" aria-label="Latest Codex articles">
  {articles.map((article) => (
    <li>
      <a class:list={['record', article.eraClass]} href={article.href}
        data-rybbit-event="home_recent_article_click" data-rybbit-prop-era={article.era}>
        <span class:list={['record__media', `record__media--${article.era.toLowerCase()}`, article.headerImage && 'record__media--image']} data-plate={article.eraMark} aria-hidden="true">
          {article.headerImage && <img src={article.headerImage} alt="" loading="lazy" decoding="async" onerror="this.hidden=true;this.parentElement.classList.remove('record__media--image')" draggable="false" />}
          <span class="record__era-mark">{article.eraMark}</span>
        </span>
        <span class="record__content">
          <span class="record__line">
            <span class="record__ordinal">{article.ordinal}</span>
            <span class="record__date">{article.kind}<time datetime={article.date.toISOString()}>{formatter.format(article.date)}</time></span>
          </span>
          <span class="record__type">{article.type}</span>
          <h3>{article.title}</h3>
          {article.description && <span class="record__description">{article.description}</span>}
        </span>
        <span class="record__bottom">
          <span class="record__era">{article.era === 'Universal' ? 'UNIVERSAL' : `${article.era} / ERA ${article.eraMark}`}</span>
          <span class="record__action">Read article <span aria-hidden="true">↗</span></span>
        </span>
      </a>
    </li>
  ))}
</ol>
        <div class="recent__foot">
          <p class="recent__hint"><span class="recent__hint--rail">Drag cards, swipe, scroll or use the arrows to browse.</span><span class="recent__hint--grid">All recent cards are visible.</span><span class="recent__hint--mobile">Era treatments in the compact article list.</span></p>
          <a class="recent__all" href="/changelog/">All Codex updates ↗</a>
        </div>
      </div>
    </section>
)}

<style>
.recent {
  --void: var(--home-void); --background: var(--home-bg); --surface: var(--home-surface);
  --ink: var(--home-gold); --text: #ece7dc; --body: #c7c0b3; --muted: #a8a295;
  --line: var(--home-line); --accent: var(--home-gold); --content: 91rem;
  --gutter: var(--home-gutter); --display: var(--vc-font-display);
  --reading: var(--vc-font-body); --ui: var(--vc-font-ui);
}
    /* Proposed homepage section. */
    .recent { position: relative; isolation: isolate; padding: clamp(3.7rem,6vw,6rem) 0 clamp(3.9rem,6vw,5.7rem); background: linear-gradient(153deg,#101010 0%,#15130f 62%,#0c0c0b 100%); border-top: 1px solid var(--line); }
    .recent__inner { width: 100%; max-width: var(--content); margin-inline: auto; padding-inline: var(--gutter); }
    .recent__top { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 1.7rem; align-items: end; margin-bottom: clamp(1.5rem,2.6vw,2.6rem); }
    .recent__title { font: 400 clamp(2.35rem,5.6vw,5rem)/1.12 var(--display); letter-spacing: -.02em; margin: 0; color: var(--text); text-wrap: balance; }
    .recent__intro { margin: .72rem 0 0; max-width: 39rem; color: var(--body); font: 400 clamp(1rem,1.48vw,1.25rem)/1.58 var(--reading); }
    .recent__tools { display: grid; justify-items: end; align-items: center; row-gap: .8rem; padding-bottom: .12rem; }
    .recent__count { color: var(--muted); margin: 0; font: 500 .8rem/1.3 var(--ui); font-variant-numeric: tabular-nums; }
    .recent__actions { display: flex; gap: .75rem; align-items: center; }
    .recent__view { min-height: 2.8rem; display: inline-flex; align-items: center; gap: .6rem; background: transparent; border: 1px solid #807563; padding: .5rem .8rem; color: #e9ddc7; font: 600 .79rem/1.3 var(--ui); cursor: pointer; white-space: nowrap; transition: background-color .16s ease, border-color .16s ease; }
    .recent__view:hover, .recent__view:focus-visible { background: #302a21; border-color: #d1c09e; }
    .recent__view svg { width: 1.05rem; height: 1.05rem; stroke: currentColor; stroke-width: 1.45; fill: none; flex: 0 0 auto; }
    .recent__controls { display: flex; align-items: center; gap: .3rem; }
    .recent__arrow { display: inline-flex; align-items: center; justify-content: center; width: 2.8rem; height: 2.8rem; padding: 0; font: 400 1.6rem/1 var(--reading); border: 1px solid #807563; background: #27231d; color: #f1e8d6; cursor: pointer; transition: border-color .14s ease, background-color .14s ease; }
    .recent__arrow:hover:not(:disabled), .recent__arrow:focus-visible:not(:disabled) { background: #3b3429; border-color: #d1c09e; }
    .recent__arrow:disabled { opacity: .35; cursor: default; }
    [hidden] { display: none !important; }

    .recent__track { --card-gap: clamp(1rem,1.9vw,1.65rem); --card-width: clamp(21rem,37vw,27rem); display: grid; grid-auto-flow: column; grid-auto-columns: var(--card-width); gap: var(--card-gap); margin: 0; padding: .2rem .2rem 1.4rem; overflow-x: auto; overflow-y: hidden; overscroll-behavior-inline: contain; scroll-padding-inline: .2rem; scroll-snap-type: x mandatory; list-style: none; scrollbar-width: thin; scrollbar-color: #9d8c70 #24211d; }
    .recent__track::-webkit-scrollbar { height: 5px; }
    .recent__track::-webkit-scrollbar-track { background: #24211d; }
    .recent__track::-webkit-scrollbar-thumb { background: #9d8c70; }
    .recent__track > li { min-width: 0; display: flex; scroll-snap-align: start; }
    .recent__track.is-draggable, .recent__track.is-draggable .record { cursor: grab; user-select: none; -webkit-user-select: none; }
    .recent__track.is-dragging, .recent__track.is-settling { scroll-snap-type: none; scroll-behavior: auto; }
    .recent__track.is-dragging, .recent__track.is-dragging .record { cursor: grabbing; }
    /* The era hues match the identity colours already used by VISCERIUM. */
    .record { --record-accent: #c8bfa8; --record-tone: #c8bfa8; display: flex; flex-direction: column; width: 100%; min-width: 0; min-height: 28rem; background: linear-gradient(160deg,#24211d,#1b1916 62%,#151513); color: var(--text); text-decoration: none; border-bottom: 1px solid #51493c; transition: background-color .15s ease, border-color .15s ease; }
    .record--citadel { --record-accent: color-mix(in srgb, var(--home-era-citadel) 62%, #f7a5a2); --record-tone: #e68d98; }
    .record--smog { --record-accent: color-mix(in srgb, var(--home-era-smog) 62%, #d7e3a0); --record-tone: #c5d28f; }
    .record--nearsight { --record-accent: color-mix(in srgb, var(--home-era-nearsight) 60%, #f4c9d5); --record-tone: #e6a0c0; }
    .record--entropy { --record-accent: color-mix(in srgb, var(--home-era-entropy) 60%, #b4e1d7); --record-tone: #8fd5cd; }
    .record--universal { --record-accent: #c8bfa8; --record-tone: #c8bfa8; }
    .record:hover, .record:focus-visible { background: #302b23; border-bottom-color: var(--record-accent); }
    .record__media { display: block; position: relative; isolation: isolate; overflow: hidden; flex: 0 0 auto; aspect-ratio: 2.2 / 1; background: linear-gradient(127deg,#464035 0%,#292823 37%,#171818 100%); border-bottom: 2px solid var(--record-accent); }
    /* These plates appear only where an article lacks a working header image. */
    .record__media--citadel { background: linear-gradient(129deg,#692432 0%,#452c30 38%,#151719 89%); }
    .record__media--smog { background: repeating-linear-gradient(92deg,transparent 0 28px,#bbca6730 29px 30px,transparent 31px 64px),linear-gradient(143deg,#525a2b 2%,#353b28 44%,#161815 100%); }
    .record__media--nearsight { background: repeating-linear-gradient(0deg,transparent 0 19px,#ffb0d012 20px,transparent 21px 42px),linear-gradient(125deg,#682849,#342637 48%,#17171b 100%); }
    .record__media--entropy { background: radial-gradient(circle at 72% 23%,#b6f6e6 0 1px,transparent 2px),radial-gradient(circle at 36% 67%,#b6f6e6 0 1px,transparent 2px),linear-gradient(138deg,#1d6865 0%,#244044 44%,#131b23 100%); }
    .record__media--universal { background: linear-gradient(120deg,#4b554b 0%,#303931 41%,#161a19 100%); }
    .record__media::before { content: attr(data-plate); position: absolute; inset: auto .5rem -3.8rem auto; z-index: 0; pointer-events: none; font: 400 13rem/1 var(--display); color: var(--record-accent); opacity: .14; }
    .record__media--image::before { content: none; }
    /* A quiet, constant era seal stays legible on both photographs and fallback plates. */
    .record__era-mark { position: absolute; z-index: 3; bottom: .7rem; left: .85rem; display: grid; place-items: center; width: 2.65rem; height: 2.65rem; padding-top: .15rem; background: #12120ff0; border: 1px solid var(--record-accent); color: var(--record-accent); font: 600 1.18rem/1 var(--display); }
    .record__media::after { content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(180deg,transparent 54%,#090b0b75 100%), url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.67' numOctaves='3' seed='5' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.13'/%3E%3C/svg%3E"); }
    .record__media img { position: relative; z-index: 1; display: block; width: 100%; height: 100%; object-fit: cover; }
    .record__media img[hidden] { display: none; }
    .record__content { padding: 1.25rem clamp(1.1rem,2vw,1.5rem) 0; flex: 1 1 auto; }
    .record__line { display: flex; justify-content: space-between; align-items: start; gap: 1rem; min-height: 2.85rem; }
    .record__ordinal { color: color-mix(in srgb,var(--record-accent) 69%,#b1a28c); font: 400 1.95rem/1 var(--display); letter-spacing: -.05em; font-variant-numeric: tabular-nums; }
    .record__date { display: block; padding-top: .12rem; color: #d3c2a8; text-align: end; font: 600 .69rem/1.42 var(--ui); letter-spacing: .02em; font-variant-numeric: tabular-nums; }
    .record__date time { display: block; color: #e4dccb; font-weight: 400; letter-spacing: 0; }
    .record__type { display: block; margin: .28rem 0 .4rem; color: var(--record-tone); font: 700 .69rem/1.4 var(--ui); text-transform: uppercase; letter-spacing: .06em; }
    .record h3 { margin: 0; color: #f0e8d8; font: 400 clamp(1.35rem,2.15vw,1.9rem)/1.29 var(--display); text-wrap: balance; overflow-wrap: break-word; }
    .record__description { margin: .85rem 0 1.2rem; max-width: 44ch; color: #c7c0b3; font: 400 1.01rem/1.57 var(--reading); text-wrap: pretty; }
    .record__bottom { display: flex; justify-content: space-between; align-items: baseline; gap: .6rem; padding: 1rem 0 0; margin: auto clamp(1.1rem,2vw,1.5rem) 1.25rem; border-top: 1px solid color-mix(in srgb,var(--record-accent) 35%,#514a3f); }
    .record__era { color: var(--record-accent); font: 700 .69rem/1.35 var(--ui); letter-spacing: .035em; }
    .record__action { flex: 0 0 auto; white-space: nowrap; color: #f4e9cd; font: 600 .78rem/1.35 var(--ui); }
    .record__action span { display: inline-block; margin-left: .25rem; transition: transform .18s ease; }
    .record:hover .record__action span, .record:focus-visible .record__action span { transform: translate(2px,-2px); }
    .recent__foot { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 1.15rem; }
    .recent__hint { margin: 0; color: #bcb3a1; font: 400 .8rem/1.5 var(--ui); }
    .recent__hint--mobile { display: none; }
    .recent__all { color: #e3d6bb; font: 600 .8rem/1.5 var(--ui); text-underline-offset: .27em; }
    .recent__all:hover { color: #fff; }

    /* Expanded mode on wider screens. The list stays in document flow. */
    .recent[data-view='grid'] .recent__track { grid-auto-flow: row; grid-template-columns: repeat(3,minmax(0,min(var(--card-width),calc((100% - 2 * var(--card-gap))/3)))); grid-auto-columns: auto; overflow: visible; scroll-snap-type: none; padding-bottom: .3rem; }
    .recent[data-view='grid'] .recent__controls { display: none; }
    .recent[data-view='grid'] .recent__hint--rail { display: none; }
    .recent[data-view='grid'] .recent__hint--grid { display: inline; }
    .recent__hint--grid { display: none; }
    @media (max-width: 1360px) and (min-width: 721px) {
      .recent__track { --card-width: clamp(19.5rem,48vw,25rem); }
      .recent[data-view='grid'] .recent__track { grid-template-columns: repeat(2,minmax(0,min(var(--card-width),calc((100% - var(--card-gap))/2)))); }
    }
    @media (max-width: 720px) {
      .context { grid-template-columns: 1fr; gap: 1rem; }
      .context__body { padding-top: 0; }
      .recent { padding-block: 3.25rem 3.7rem; }
      .recent__top { display: block; margin-bottom: 1.4rem; }
      .recent__title { font-size: clamp(2.15rem,8vw,3.25rem); }
      .recent__intro { font-size: 1.05rem; }
      .recent__tools { display: block; margin-top: 1rem; }
      .recent__view, .recent__controls { display: none !important; }
      .recent__count { font-size: .76rem; }
      .recent__track, .recent[data-view='grid'] .recent__track { display: grid; grid-auto-flow: row; grid-template-columns: minmax(0,1fr); grid-auto-columns: auto; gap: 0; overflow: visible; scroll-snap-type: none; padding: 0; }
      .recent__track > li { display: block; scroll-snap-align: none; }
      .record { min-height: 0; display: grid; grid-template-columns: clamp(5.5rem,26vw,8.4rem) minmax(0,1fr); grid-template-areas: 'media content' 'media bottom'; column-gap: clamp(.85rem,3vw,1.3rem); padding: 1.1rem 0; background: transparent; border-top: 1px solid #51493c; border-bottom: none; }
      .record:hover, .record:focus-visible { background: #24211d; }
      .record__media { grid-area: media; min-height: 9rem; height: 100%; aspect-ratio: auto; border: 1px solid #534a3e; }
      .record__media::before { font-size: 8rem; bottom: -1.9rem; right: -.25rem; }
      .record__era-mark { width: 2.1rem; height: 2.1rem; left: .4rem; bottom: .4rem; font-size: .9rem; }
      .record__content { grid-area: content; padding: 0; }
      .record__line { min-height: 0; }
      .record__ordinal { display: none; }
      .record__date { padding: 0; text-align: start; font-size: .67rem; }
      .record__date time { display: inline; margin-left: .36rem; }
      .record__type { margin: .65rem 0 .32rem; font-size: .65rem; }
      .record h3 { font-size: clamp(1.07rem,4.7vw,1.45rem); line-height: 1.25; }
      .record__description { margin: .42rem 0 0; font-size: .91rem; line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
      .record__bottom { grid-area: bottom; border: none; margin: .68rem 0 0; padding: 0; flex-wrap: wrap; gap: .35rem .7rem; align-items: center; }
      .record__era { font-size: .61rem; }
      .record__action { font-size: .73rem; }
      .recent__hint--rail, .recent__hint--grid { display: none !important; }
      .recent__hint--mobile { display: inline; }
    }
    @media (max-width: 330px) {
      .recent__intro { font-size: .99rem; }
      /* Below 331px, side thumbnails crowd the title. Keep the list, stack each card. */
      .record { grid-template-columns: minmax(0,1fr); grid-template-areas: 'media' 'content' 'bottom'; row-gap: .5rem; }
      .record__media { height: 5.6rem; min-height: 5.6rem; }
      .record__media::before { font-size: 8.5rem; bottom: -3.6rem; right: 1.1rem; }
      .record__era-mark { left: .55rem; bottom: .5rem; }
      .record__content { padding-top: .15rem; }
      .record__date { font-size: .67rem; }
      .record__type { margin: .45rem 0 .3rem; }
      .record h3 { font-size: 1.19rem; }
      .record__description { -webkit-line-clamp: 2; line-clamp: 2; font-size: .91rem; }
      .record__bottom { gap: .4rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      *,*::before,*::after { scroll-behavior: auto !important; transition: none !important; }
    }
    @media (forced-colors: active) {
      .record,.recent__view,.recent__arrow { border: 1px solid CanvasText; }
      .recent__arrow:disabled { color: GrayText; }
      .record__media { border: 1px solid CanvasText; }
    }
  
</style>

<script>

    (() => {
      const section = document.getElementById('recent-articles');
      if (!section) return;
      const track = document.getElementById('recent-track');
      const toggle = document.getElementById('recent-toggle');
      const toggleText = document.getElementById('recent-toggle-text');
      const previous = document.getElementById('recent-prev');
      const next = document.getElementById('recent-next');
      const mobile = window.matchMedia('(max-width: 720px)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const slides = [...track.children];
      let scrollFrame = 0;
      let settleFrame = 0;
      let drag = null;
      let suppressClick = false;
      const isRail = () => section.dataset.view === 'rail' && !mobile.matches;
      const stepSize = () => slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : slides[0]?.offsetWidth || 0;
      const updateControls = () => {
        const active = isRail();
        const maximum = Math.max(0, track.scrollWidth - track.clientWidth);
        const scrollable = active && maximum > 3;
        track.classList.toggle('is-draggable', scrollable);
        previous.hidden = !scrollable;
        next.hidden = !scrollable;
        previous.disabled = !scrollable || track.scrollLeft <= 3;
        next.disabled = !scrollable || track.scrollLeft >= maximum - 3;
        toggle.hidden = mobile.matches;
        track.tabIndex = active && scrollable ? 0 : -1;
      };
      const cancelSettle = () => {
        cancelAnimationFrame(settleFrame);
        settleFrame = 0;
        track.classList.remove('is-settling');
      };
      const scrollOne = direction => {
        if (!isRail()) return;
        cancelSettle();
        const step = stepSize();
        if (!step) return;
        const maximum = Math.max(0, track.scrollWidth - track.clientWidth);
        const index = Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / step) + direction));
        track.scrollTo({left: Math.min(index * step, maximum), behavior: reducedMotion.matches ? 'instant' : 'smooth'});
      };
      const stopDrag = () => {
        if (!drag) return;
        const {id, moved} = drag;
        drag = null;
        if (moved && isRail()) track.classList.add('is-settling');
        track.classList.remove('is-dragging');
        if (moved) suppressClick = true;
        if (track.hasPointerCapture(id)) track.releasePointerCapture(id);
        if (!moved || !isRail()) return;
        const step = stepSize();
        const maximum = Math.max(0, track.scrollWidth - track.clientWidth);
        const target = Math.min(Math.round(track.scrollLeft / step) * step, maximum);
        const from = track.scrollLeft;
        if (reducedMotion.matches || Math.abs(target - from) < 1) {
          track.scrollLeft = target;
          track.classList.remove('is-settling');
          return;
        }
        const duration = 380;
        let started;
        const animate = now => {
          if (started === undefined) started = now;
          const progress = Math.min((now - started) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          track.scrollLeft = from + (target - from) * eased;
          if (progress < 1) settleFrame = requestAnimationFrame(animate);
          else {
            settleFrame = 0;
            track.scrollLeft = target;
            track.classList.remove('is-settling');
          }
        };
        settleFrame = requestAnimationFrame(animate);
      };
      track.addEventListener('pointerdown', event => {
        suppressClick = false;
        if (event.pointerType !== 'mouse' || event.button !== 0 || !isRail() || track.scrollWidth <= track.clientWidth) return;
        cancelSettle();
        drag = {id: event.pointerId, x: event.clientX, left: track.scrollLeft, moved: false};
      });
      track.addEventListener('pointermove', event => {
        if (!drag || event.pointerId !== drag.id) return;
        const distance = event.clientX - drag.x;
        if (!drag.moved && Math.abs(distance) < 7) return;
        if (!drag.moved) {
          drag.moved = true;
          track.classList.add('is-dragging');
          track.setPointerCapture(event.pointerId);
        }
        event.preventDefault();
        track.scrollLeft = drag.left - distance;
      });
      window.addEventListener('pointerup', event => { if (drag?.id === event.pointerId) stopDrag(); });
      track.addEventListener('pointercancel', stopDrag);
      track.addEventListener('lostpointercapture', stopDrag);
      window.addEventListener('blur', stopDrag);
      track.addEventListener('dragstart', event => { if (isRail()) event.preventDefault(); });
      track.addEventListener('click', event => {
        if (!suppressClick) return;
        event.preventDefault();
        event.stopPropagation();
        suppressClick = false;
      }, true);
      toggle.addEventListener('click', () => {
        stopDrag();
        cancelSettle();
        const expanded = section.dataset.view !== 'grid';
        section.dataset.view = expanded ? 'grid' : 'rail';
        toggle.setAttribute('aria-expanded', String(expanded));
        toggleText.textContent = expanded ? 'Return to carousel' : 'Expand to grid';
        updateControls();
      });
      previous.addEventListener('click', () => scrollOne(-1));
      next.addEventListener('click', () => scrollOne(1));
      track.addEventListener('scroll', () => {
        if (scrollFrame) cancelAnimationFrame(scrollFrame);
        scrollFrame = requestAnimationFrame(updateControls);
      }, {passive:true});
      track.addEventListener('keydown', event => {
        if (event.target !== track || !isRail()) return;
        if (event.key === 'ArrowRight') { event.preventDefault(); scrollOne(1); }
        if (event.key === 'ArrowLeft') { event.preventDefault(); scrollOne(-1); }
      });
      if ('ResizeObserver' in window) new ResizeObserver(updateControls).observe(track);
      else window.addEventListener('resize', updateControls);
      if (mobile.addEventListener) mobile.addEventListener('change', () => { stopDrag(); cancelSettle(); updateControls(); });
      else mobile.addListener(() => { stopDrag(); cancelSettle(); updateControls(); });
      updateControls();
    })();
  
</script>
