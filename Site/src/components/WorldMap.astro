---
import '../styles/maps.css';
import '../styles/exploration-pages.css';
import { DEFAULT_LOCALE } from '../../site.config.mjs';

type AtlasMarker = {
  title?: string;
  description?: string;
  page?: string;
  childMapId?: string;
  type?: string;
  marker?: string;
  region?: string;
  faction?: string | string[];
  era?: string | string[];
  layer?: string | string[];
  layers?: string[];
  x?: number;
  y?: number;
  minZoom?: number;
  maxZoom?: number;
};

type AtlasMap = {
  id?: string;
  title?: string;
  description?: string;
  page?: string;
  image?: string;
  markers?: AtlasMarker[];
  [key: string]: unknown;
};

const map = (Astro.props as { map?: AtlasMap }).map;
const { t } = Astro.locals;
const locale = Astro.currentLocale ?? DEFAULT_LOCALE;
const messages = {
  layers: t('viscerium.map.layers'),
  all: t('viscerium.map.all'),
  untitledLocation: t('viscerium.map.untitledLocation'),
  openNested: t('viscerium.map.openNested'),
  openArticle: t('viscerium.common.openArticle'),
  imageLabel: t('viscerium.map.imageLabel'),
  markerLabel: t('viscerium.map.markerLabel'),
  noMatches: t('viscerium.map.noMatches'),
  untitledMarker: t('viscerium.map.untitledMarker'),
};
const payload = JSON.stringify({ ...(map ?? {}), _locale: locale, _messages: messages }).replace(/</g, '\\u003c');
const positionedMarkers = map?.markers?.filter((marker) => Number.isFinite(marker.x) && Number.isFinite(marker.y)) ?? [];
const atlasId = `atlas-${String(map?.id ?? 'map').replace(/[^a-z0-9_-]+/gi, '-').toLowerCase()}`;
---

{map ? (
  <section
    class="atlas"
    data-atlas
    data-focus-enter-label={t('viscerium.common.enterFocusMode')}
    data-focus-exit-label={t('viscerium.common.exitFocusMode')}
    data-focus-enter-text={t('viscerium.common.focus')}
    data-focus-exit-text={t('viscerium.common.exit')}
  >
    <header class="atlas__header">
      <div>
        <p class="atlas__eyebrow">{t('viscerium.map.atlas')}</p>
        <h1>{map.title}</h1>
        {map.description && <p>{map.description}</p>}
      </div>
      {map.page && <a class="atlas__article-link" href={map.page} data-mobile-label={t('viscerium.map.notes')}>{t('viscerium.map.readNotes')}</a>}
    </header>

    {map.image ? (
      <>
        <div class="atlas__toolbar" aria-label={t('viscerium.map.controls')}>
          <div class="atlas-search" data-atlas-search-shell>
            <label for={`${atlasId}-search`}>{t('viscerium.map.findPlace')}</label>
            <input
              id={`${atlasId}-search`}
              type="search"
              placeholder={t('viscerium.map.searchPlaceholder')}
              autocomplete="off"
              data-atlas-search
            />
            <div class="atlas-search__results" data-atlas-search-results hidden></div>
          </div>
          <button type="button" class="atlas__reset" data-atlas-reset>{t('viscerium.map.resetView')}</button>
        </div>

        <div class="atlas__frame">
          <div
            class="atlas__canvas"
            data-atlas-canvas
            role="application"
            aria-label={t('viscerium.map.interactiveLabel', { title: map.title, interpolation: { escapeValue: false } })}
          ></div>

          <div class="exploration-surface-controls atlas__surface-controls" aria-label={t('viscerium.map.mobileControls')}>
            <button
              type="button"
              class="exploration-control"
              popovertarget={`${atlasId}-mobile-search`}
              aria-label={t('viscerium.map.searchLabel')}
            >
              <span aria-hidden="true">⌕</span>
              <span>{t('viscerium.common.search')}</span>
            </button>
            <button type="button" class="exploration-control" data-atlas-reset aria-label={t('viscerium.map.resetLabel')}>
              <span aria-hidden="true">↺</span>
              <span>{t('viscerium.common.reset')}</span>
            </button>
            <button type="button" class="exploration-control" data-exploration-focus-toggle aria-pressed="false" aria-label={t('viscerium.common.enterFocusMode')}>
              <span aria-hidden="true">⛶</span>
              <span data-exploration-focus-label>{t('viscerium.common.focus')}</span>
            </button>
          </div>
        </div>

        <div id={`${atlasId}-mobile-search`} class="exploration-popover atlas__mobile-search" popover>
          <div class="exploration-popover__header">
            <strong>{t('viscerium.map.findPlace')}</strong>
            <button type="button" class="exploration-popover__close" popovertarget={`${atlasId}-mobile-search`} popovertargetaction="hide" aria-label={t('viscerium.common.closeSearch')}>×</button>
          </div>
          <div class="atlas-search" data-atlas-search-shell>
            <label for={`${atlasId}-mobile-search-input`}>{t('viscerium.map.searchLabel')}</label>
            <input
              id={`${atlasId}-mobile-search-input`}
              type="search"
              placeholder={t('viscerium.map.searchPlaceholder')}
              autocomplete="off"
              data-atlas-search
            />
            <div class="atlas-search__results" data-atlas-search-results hidden></div>
          </div>
        </div>

        <dialog class="exploration-sheet atlas__inspector" data-atlas-inspector aria-label={t('viscerium.map.locationDetails')}>
          <div class="exploration-sheet__handle" aria-hidden="true"></div>
          <div class="exploration-sheet__header">
            <span class="atlas__eyebrow">{t('viscerium.map.location')}</span>
            <button type="button" class="exploration-sheet__close" data-exploration-dialog-close aria-label={t('viscerium.map.closeDetails')}>×</button>
          </div>
          <div data-atlas-inspector-content></div>
        </dialog>

        <script type="application/json" data-atlas-payload set:html={payload}></script>
      </>
    ) : (
      <p class="codex-warning">{t('viscerium.map.noImage')}</p>
    )}

    <details class="atlas__marker-index">
      <summary>{t('viscerium.map.markerIndex', { count: map.markers?.length ?? 0 })}</summary>
      {map.markers?.length ? (
        <ul>
          {map.markers.map((marker) => (
            <li>
              <a href={marker.page}>{marker.title}</a>
              {marker.description ? <> — {marker.description}</> : null}
              {!Number.isFinite(marker.x) || !Number.isFinite(marker.y) ? <span> {t('viscerium.map.notPositioned')}</span> : null}
            </li>
          ))}
        </ul>
      ) : <p>{t('viscerium.map.noMarkers')}</p>}
    </details>

    {map.image && positionedMarkers.length === 0 && (
      <p class="atlas__empty-note">{t('viscerium.map.noPositionedMarkers')}</p>
    )}
  </section>
) : <p class="codex-warning">{t('viscerium.map.notFound')}</p>}

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import 'leaflet.control.layers.tree';
  import 'leaflet.control.layers.tree/L.Control.Layers.Tree.css';
  import Fuse from 'fuse.js';
  import {
    bindExplorationDialog,
    bindExplorationFocus,
    closeContainingPopover,
    explorationMobileQuery,
    showExplorationDialog,
  } from '../lib/exploration-ui.mjs';

  type AtlasMarker = {
    title?: string;
    description?: string;
    page?: string;
    childMapId?: string;
    type?: string;
    marker?: string;
    region?: string;
    faction?: string | string[];
    era?: string | string[];
    layer?: string | string[];
    layers?: string[];
    x?: number;
    y?: number;
    minZoom?: number;
    maxZoom?: number;
  };

  type AtlasMessages = {
    layers: string;
    all: string;
    untitledLocation: string;
    openNested: string;
    openArticle: string;
    imageLabel: string;
    markerLabel: string;
    noMatches: string;
    untitledMarker: string;
  };

  type AtlasTiles = {
    urlTemplate?: string;
    tileSize?: number;
    minNativeZoom?: number;
    maxNativeZoom?: number;
    zoomOffset?: number;
    width?: number;
    height?: number;
  };

  type AtlasPayload = {
    image: string;
    title?: string;
    width?: number;
    height?: number;
    minZoom?: number;
    maxZoom?: number;
    defaultZoom?: number;
    tiles?: AtlasTiles;
    markers?: AtlasMarker[];
    _locale?: string;
    _messages: AtlasMessages;
  };

  type LayerTreeNode = {
    children: Map<string, LayerTreeNode>;
    layer: L.Layer | null;
  };

  type MarkerRecord = {
    marker: AtlasMarker;
    leafletMarker: L.Marker;
    group: L.LayerGroup;
    latLng: L.LatLng;
    layers: string[];
  };

  type MarkerSearchItem = {
    index: number;
    title?: string;
    description?: string;
    type?: string;
    era?: string;
    faction?: string;
    region?: string;
    layers: string;
  };

  const markerGlyphs: Record<string, string> = {
    capital: '◆',
    city: '●',
    settlement: '●',
    town: '●',
    village: '•',
    location: '•',
    map: '▣',
    fortification: '▲',
    military: '▲',
    battlefield: '✦',
    ruin: '◇',
    rift: '✹',
    myrkild: '✹',
    naranor: '⬡',
    anomaly: '⬡',
    port: '◆',
    infrastructure: '■',
    natural: '△',
  };

  function cleanClass(value: unknown) {
    return String(value ?? 'location').toLowerCase().replace(/[^a-z0-9_-]+/g, '-');
  }

  function prettify(value: unknown) {
    return String(value ?? '')
      .replace(/[_-]+/g, ' ')
      .replace(/\b\w/g, (character) => character.toUpperCase());
  }

  function normaliseLayers(marker: AtlasMarker): string[] {
    const layers = Array.isArray(marker.layers)
      ? marker.layers
      : Array.isArray(marker.layer)
        ? marker.layer
        : marker.layer
          ? [marker.layer]
          : [];
    return layers.map((layer) => String(layer).trim()).filter(Boolean);
  }

  function layerParts(value: string): string[] {
    return String(value).split(/[/:>]+/).map((part) => part.trim()).filter(Boolean);
  }

  function buildLayerTree(
    layerGroups: Map<string, L.LayerGroup>,
    locale: string,
    messages: AtlasMessages,
  ): L.Control.Layers.TreeObject {
    const root: LayerTreeNode = { children: new Map(), layer: null };

    for (const [name, layer] of layerGroups) {
      const parts = layerParts(name);
      let node = root;
      for (const part of parts.length ? parts : ['locations']) {
        if (!node.children.has(part)) node.children.set(part, { children: new Map(), layer: null });
        node = node.children.get(part)!;
      }
      node.layer = layer;
    }

    const convert = (
      label: string,
      node: LayerTreeNode,
      locale: string,
      messages: AtlasMessages,
    ): L.Control.Layers.TreeObject => {
      const children: L.Control.Layers.TreeObject[] = [...node.children.entries()]
        .sort(([a], [b]) => a.localeCompare(b, locale))
        .map(([childLabel, child]) => convert(childLabel, child, locale, messages));
      if (node.layer && children.length === 0) return { label: prettify(label), layer: node.layer };
      if (node.layer) children.unshift({ label: messages.all, layer: node.layer });
      return { label: prettify(label), children };
    };

    return {
      label: messages.layers,
      children: [...root.children.entries()]
        .sort(([a], [b]) => a.localeCompare(b, locale))
        .map(([label, node]) => convert(label, node, locale, messages)),
    };
  }

  function createMarkerDetails(marker: AtlasMarker, messages: AtlasMessages) {
    const article = document.createElement('article');
    article.className = 'atlas-popup';

    const title = document.createElement('h3');
    title.textContent = marker.title || messages.untitledLocation;
    article.append(title);

    const metadata = [marker.type, marker.region, marker.faction, marker.era]
      .flatMap((value) => Array.isArray(value) ? value : [value])
      .filter(Boolean)
      .map((value) => prettify(value));
    if (metadata.length) {
      const meta = document.createElement('p');
      meta.className = 'atlas-popup__meta';
      meta.textContent = [...new Set(metadata)].join(' · ');
      article.append(meta);
    }

    if (marker.description) {
      const description = document.createElement('p');
      description.textContent = marker.description;
      article.append(description);
    }

    if (marker.page) {
      const link = document.createElement('a');
      link.href = marker.page;
      link.textContent = marker.childMapId ? messages.openNested : messages.openArticle;
      article.append(link);
    }

    return article;
  }

  function readImageDimensions(
    src: string,
    width: number,
    height: number,
  ): Promise<{ width: number; height: number }> {
    if (Number.isFinite(width) && Number.isFinite(height) && width > 0 && height > 0) {
      return Promise.resolve({ width, height });
    }
    return new Promise<{ width: number; height: number }>((resolve) => {
      const image = new Image();
      image.onload = () => resolve({
        width: Number.isFinite(width) && width > 0 ? width : image.naturalWidth || 1000,
        height: Number.isFinite(height) && height > 0 ? height : image.naturalHeight || 1000,
      });
      image.onerror = () => resolve({ width: width || 1000, height: height || 1000 });
      image.src = src;
    });
  }

  function widthFitZoom(canvas: HTMLElement, imageWidth: number, horizontalGutter: number) {
    const viewportWidth = canvas.getBoundingClientRect().width || canvas.clientWidth || imageWidth;
    const usableWidth = Math.max(1, viewportWidth - (horizontalGutter * 2));
    return Math.log2(usableWidth / imageWidth);
  }

  async function initialiseAtlas(root: HTMLElement) {
    if (root.dataset.atlasReady) return;
    root.dataset.atlasReady = 'loading';

    const canvas = root.querySelector<HTMLElement>('[data-atlas-canvas]');
    const payloadElement = root.querySelector<HTMLScriptElement>('[data-atlas-payload]');
    const inspector = root.querySelector<HTMLDialogElement>('[data-atlas-inspector]');
    const inspectorContent = root.querySelector<HTMLElement>('[data-atlas-inspector-content]');
    if (!canvas || !payloadElement) {
      root.dataset.atlasReady = 'error';
      return;
    }

    let data: AtlasPayload;
    try {
      data = JSON.parse(payloadElement.textContent || '{}') as AtlasPayload;
    } catch {
      root.dataset.atlasReady = 'error';
      return;
    }
    const locale = data._locale || document.documentElement.lang;
    const messages = data._messages;

    const mobileQuery = explorationMobileQuery();
    if (inspector) bindExplorationDialog(inspector);

    const tiles = data.tiles ?? null;
    const dimensions = await readImageDimensions(
      data.image,
      Number(tiles?.width ?? data.width),
      Number(tiles?.height ?? data.height),
    );
    const width = dimensions.width;
    const height = dimensions.height;
    // Shift the simple CRS so the top-left of the illustrated map is [0, 0].
    // This makes Leaflet tile X/Y coordinates line up with Sharp's Google layout
    // while preserving all authored marker positions as percentages.
    const bounds = L.latLngBounds([-height, 0], [0, width]);
    const horizontalGutter = mobileQuery.matches ? 16 : 24;

    const atlas = L.map(canvas, {
      crs: L.CRS.Simple,
      attributionControl: false,
      zoomControl: true,
      zoomSnap: 0,
      zoomDelta: 0.5,
      minZoom: -8,
      maxZoom: 8,
      maxBounds: bounds.pad(0.15),
      maxBoundsViscosity: 0.9,
    });

    if (
      tiles?.urlTemplate
      && Number.isFinite(Number(tiles.tileSize))
      && Number.isFinite(Number(tiles.zoomOffset))
    ) {
      L.tileLayer(tiles.urlTemplate, {
        tileSize: Number(tiles.tileSize),
        minZoom: -16,
        maxZoom: 16,
        minNativeZoom: Number(tiles.minNativeZoom),
        maxNativeZoom: Number(tiles.maxNativeZoom),
        zoomOffset: Number(tiles.zoomOffset),
        bounds,
        noWrap: true,
        keepBuffer: 2,
        className: 'atlas-map-tile',
      }).addTo(atlas);
      root.dataset.atlasRaster = 'tiles';
    } else {
      L.imageOverlay(data.image, bounds, {
        interactive: false,
        alt: data.title || messages.imageLabel,
      }).addTo(atlas);
      root.dataset.atlasRaster = 'image';
    }

    const widthFittedZoom = widthFitZoom(canvas, width, horizontalGutter);
    const configuredMinZoom = Number(data.minZoom);
    const configuredMaxZoom = Number(data.maxZoom);
    atlas.setMinZoom(Number.isFinite(configuredMinZoom) ? configuredMinZoom : widthFittedZoom - 1);
    atlas.setMaxZoom(Number.isFinite(configuredMaxZoom) ? configuredMaxZoom : Math.max(widthFittedZoom + 5, 4));

    const defaultViewZoom = () => {
      const configuredDefaultZoom = Number(data.defaultZoom);
      const preferredZoom = Number.isFinite(configuredDefaultZoom)
        ? configuredDefaultZoom
        : widthFitZoom(canvas, width, mobileQuery.matches ? 16 : 24);
      return Math.max(atlas.getMinZoom(), Math.min(preferredZoom, atlas.getMaxZoom()));
    };

    const setDefaultView = ({ animate = false }: { animate?: boolean } = {}) => {
      atlas.setView(bounds.getCenter(), defaultViewZoom(), { animate });
    };

    setDefaultView();
    const fittedZoom = atlas.getZoom();

    const validMarkers = (data.markers ?? []).filter((marker) => Number.isFinite(marker.x) && Number.isFinite(marker.y));
    const layerGroups = new Map<string, L.LayerGroup>();
    const markerRecords: MarkerRecord[] = [];

    const getLayerGroup = (name: string | undefined): L.LayerGroup => {
      const layerName = name || 'locations';
      if (!layerGroups.has(layerName)) {
        const group = L.layerGroup().addTo(atlas);
        layerGroups.set(layerName, group);
      }
      return layerGroups.get(layerName)!;
    };

    const openInspector = (marker: AtlasMarker) => {
      if (!inspector || !inspectorContent) return;
      inspectorContent.replaceChildren(createMarkerDetails(marker, messages));
      showExplorationDialog(inspector);
    };

    for (const marker of validMarkers) {
      const layers = normaliseLayers(marker);
      const primaryLayer = layers[0] || 'locations';
      const group = getLayerGroup(primaryLayer);
      const markerKind = cleanClass(marker.marker || marker.type || 'location');
      const glyph = markerGlyphs[markerKind] || markerGlyphs.location;
      const latLng = L.latLng(
        -(Number(marker.y) / 100) * height,
        (Number(marker.x) / 100) * width,
      );

      const icon = L.divIcon({
        className: `atlas-marker atlas-marker--${markerKind}`,
        html: `<span class="atlas-marker__core" aria-hidden="true">${glyph}</span>`,
        iconSize: [22, 22],
        iconAnchor: [11, 11],
        popupAnchor: [0, -12],
      });

      const leafletMarker = L.marker(latLng, {
        icon,
        title: marker.title || '',
        alt: marker.title || messages.markerLabel,
        keyboard: true,
      });
      leafletMarker.bindTooltip(marker.title || '', {
        direction: 'top',
        offset: [0, -10],
        opacity: 0.96,
      });
      leafletMarker.bindPopup(createMarkerDetails(marker, messages), {
        className: 'atlas-leaflet-popup',
        maxWidth: 320,
      });
      leafletMarker.on('click', () => {
        if (!mobileQuery.matches) return;
        leafletMarker.closePopup();
        openInspector(marker);
      });
      group.addLayer(leafletMarker);
      markerRecords.push({ marker, leafletMarker, group, latLng, layers });
    }

    if (layerGroups.size > 0) {
      const overlayTree = buildLayerTree(layerGroups, locale, messages);
      const layerOptions: L.Control.LayersOptions = {
        collapsed: mobileQuery.matches,
        position: 'topright',
      };
      if (L.control.layers?.tree) L.control.layers.tree(undefined, overlayTree, layerOptions).addTo(atlas);
      else L.control.layers(undefined, Object.fromEntries(layerGroups), layerOptions).addTo(atlas);
    }

    const withinZoom = (record: MarkerRecord, zoom: number) => {
      const minZoom = Number(record.marker.minZoom);
      const maxZoom = Number(record.marker.maxZoom);
      if (Number.isFinite(minZoom) && zoom < minZoom) return false;
      if (Number.isFinite(maxZoom) && zoom > maxZoom) return false;
      return true;
    };

    const applyZoomVisibility = () => {
      const zoom = atlas.getZoom();
      root.dataset.atlasZoom = String(zoom);
      for (const record of markerRecords) {
        const visible = withinZoom(record, zoom);
        const present = record.group.hasLayer(record.leafletMarker);
        if (visible && !present) record.group.addLayer(record.leafletMarker);
        if (!visible && present) record.group.removeLayer(record.leafletMarker);
      }
    };
    atlas.on('zoomend', applyZoomVisibility);
    applyZoomVisibility();

    const focusRecord = (record: MarkerRecord) => {
      let targetZoom = atlas.getZoom();
      const minZoom = Number(record.marker.minZoom);
      const maxZoom = Number(record.marker.maxZoom);
      if (Number.isFinite(minZoom)) targetZoom = Math.max(targetZoom, minZoom);
      if (Number.isFinite(maxZoom)) targetZoom = Math.min(targetZoom, maxZoom);
      targetZoom = Math.max(targetZoom, fittedZoom + 1);
      targetZoom = Math.min(targetZoom, atlas.getMaxZoom());
      if (!atlas.hasLayer(record.group)) record.group.addTo(atlas);
      atlas.setView(record.latLng, targetZoom, { animate: true });
      if (!record.group.hasLayer(record.leafletMarker)) record.group.addLayer(record.leafletMarker);
      if (mobileQuery.matches) openInspector(record.marker);
      else record.leafletMarker.openPopup();
    };

    const searchItems: MarkerSearchItem[] = markerRecords.map((record, index) => ({
      index,
      title: record.marker.title,
      description: record.marker.description,
      type: record.marker.type,
      era: Array.isArray(record.marker.era) ? record.marker.era.join(' ') : record.marker.era,
      faction: Array.isArray(record.marker.faction) ? record.marker.faction.join(' ') : record.marker.faction,
      region: record.marker.region,
      layers: record.layers.join(' '),
    }));
    const fuse = new Fuse<MarkerSearchItem>(searchItems, {
      threshold: 0.35,
      ignoreLocation: true,
      keys: [
        { name: 'title', weight: 3 },
        { name: 'region', weight: 1.5 },
        { name: 'faction', weight: 1.25 },
        'description',
        'type',
        'era',
        'layers',
      ],
    });

    const bindSearch = (searchShell: HTMLElement) => {
      const searchInput = searchShell.querySelector<HTMLInputElement>('[data-atlas-search]');
      const searchResults = searchShell.querySelector<HTMLElement>('[data-atlas-search-results]');
      if (!searchInput || !searchResults || searchInput.dataset.atlasSearchBound === 'true') return;
      searchInput.dataset.atlasSearchBound = 'true';

      const hideResults = () => {
        searchResults.hidden = true;
        searchResults.replaceChildren();
      };

      searchInput.addEventListener('input', () => {
        const query = searchInput.value.trim();
        if (!query) {
          hideResults();
          return;
        }
        const matches = fuse.search(query, { limit: 8 });
        searchResults.replaceChildren();
        if (!matches.length) {
          const empty = document.createElement('p');
          empty.className = 'atlas-search__empty';
          empty.textContent = messages.noMatches;
          searchResults.append(empty);
        } else {
          for (const match of matches) {
            const record = markerRecords[match.item.index];
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'atlas-search__result';
            const title = document.createElement('strong');
            title.textContent = record.marker.title || messages.untitledMarker;
            const meta = document.createElement('span');
            meta.textContent = [record.marker.type, record.marker.region, record.marker.faction]
              .flatMap((value) => Array.isArray(value) ? value : [value])
              .filter(Boolean)
              .map(prettify)
              .join(' · ');
            button.append(title, meta);
            button.addEventListener('click', () => {
              focusRecord(record);
              hideResults();
              closeContainingPopover(button);
            });
            searchResults.append(button);
          }
        }
        searchResults.hidden = false;
      });
      searchInput.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') hideResults();
      });
    };

    root.querySelectorAll<HTMLElement>('[data-atlas-search-shell]').forEach(bindSearch);

    const resetAtlas = () => {
      setDefaultView({ animate: true });
      root.querySelectorAll<HTMLInputElement>('[data-atlas-search]').forEach((input) => { input.value = ''; });
      root.querySelectorAll<HTMLElement>('[data-atlas-search-results]').forEach((results) => {
        results.hidden = true;
        results.replaceChildren();
      });
    };
    root.querySelectorAll<HTMLButtonElement>('[data-atlas-reset]').forEach((button) => button.addEventListener('click', resetAtlas));

    bindExplorationFocus(root, () => requestAnimationFrame(() => atlas.invalidateSize({ pan: false })));
    const observer = new ResizeObserver(() => atlas.invalidateSize({ pan: false }));
    observer.observe(canvas);
    root.dataset.atlasReady = 'true';
  }

  function bootAtlases() {
    document.querySelectorAll<HTMLElement>('[data-atlas]').forEach((root) => initialiseAtlas(root));
  }

  bootAtlases();
  document.addEventListener('astro:page-load', bootAtlases);
</script>