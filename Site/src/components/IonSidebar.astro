---
import { getCollection } from 'astro:content';
import SidebarSublist from './IonSidebarSublist.astro';
import { parseIconLabel } from '../lib/icon-spec.mjs';
import { HISTORICAL_ERAS, eraFromPath, normaliseEra } from '../lib/era-context.mjs';
import { filterSidebarByRoutes, universalRoutesFromDocs } from '../lib/sidebar-era-scope.mjs';

const { sidebar, entry } = Astro.locals.starlightRoute;
const changelogSidebarLabel = 'Releases';
const labelOf = (entry: any) => parseIconLabel(entry?.label ?? '').label.trim();
const isChangelogGroup = (entry: any) => entry.type === 'group' && labelOf(entry) === changelogSidebarLabel;
const changelogSidebar = sidebar.filter(isChangelogGroup);
const mainSidebar = sidebar.filter((entry: any) => !isChangelogGroup(entry));
const mainGroups = mainSidebar.filter((entry: any) => entry.type === 'group');
const mainArticles = mainSidebar.filter((entry: any) => entry.type === 'link');
const erasGroup = mainGroups.find((entry: any) => labelOf(entry).toLowerCase() === 'eras');
const eraEntry = (era: string) => erasGroup?.entries?.find((entry: any) => labelOf(entry).toUpperCase() === era);
const childrenOf = (entry: any) => entry?.type === 'group' ? entry.entries ?? [] : entry ? [entry] : [];

// Universal is a content scope, not a route/folder requirement. Build the shared
// sidebar from page metadata so naturally filed material such as Degel System is
// still visible inside every historical era context.
const docs = await getCollection('docs');
const universalRoutes = universalRoutesFromDocs(docs);
const universalSidebar = filterSidebarByRoutes(mainSidebar, universalRoutes);
const universalEntries = universalSidebar.flatMap((entry: any) =>
  entry.type === 'group' && labelOf(entry).toLowerCase() === 'universal'
    ? entry.entries ?? []
    : [entry]
);

const pageData = entry.data;
const pageSlug = String(pageData.slug ?? entry.id ?? '').replace(/\.(md|mdx)$/i, '');
const rawEra = Array.isArray(pageData.era) ? pageData.era[0] : pageData.era;
const routeEra = normaliseEra(rawEra) ?? eraFromPath(pageSlug);
const initialEra = routeEra && HISTORICAL_ERAS.includes(routeEra) ? routeEra : undefined;
---

<div class="codex-sidebar-layout">
  <div class="codex-sidebar-global" hidden={Boolean(initialEra)}>
    <div class="codex-sidebar-main">
      <SidebarSublist sublist={mainGroups} />
    </div>
    {mainArticles.length > 0 && (
      <div class="codex-sidebar-articles">
        <SidebarSublist sublist={mainArticles} />
      </div>
    )}
  </div>

  {HISTORICAL_ERAS.map((era) => {
    const scoped = childrenOf(eraEntry(era));
    const eraSlug = era.toLowerCase();
    return (
      <div
        class="codex-sidebar-era-scope"
        data-era-sidebar={era}
        hidden={initialEra !== era}
      >
        <div class="codex-sidebar-era-toolbar">
          <strong>{era}</strong>
          <a href="/" data-era-exit>Exit · All eras</a>
        </div>
        <nav class="codex-sidebar-era-explore" aria-label={`${era} exploration`}>
          <a href={`/eras/${eraSlug}/relationships/`}>Relationships</a>
        </nav>
        {scoped.length > 0 ? <SidebarSublist sublist={scoped} /> : <p class="codex-sidebar-empty">No published {era} pages yet.</p>}
        {universalEntries.length > 0 && (
          <div class="codex-sidebar-universal">
            <div class="codex-sidebar-universal__label">Universal</div>
            <SidebarSublist sublist={universalEntries} />
          </div>
        )}
      </div>
    );
  })}

  {changelogSidebar.length > 0 && (
    <aside class="codex-changelog-sidebar" aria-label="Releases">
      <SidebarSublist sublist={changelogSidebar} />
    </aside>
  )}
</div>

<style>
  @layer starlight.core {
    .codex-sidebar-layout {
      box-sizing: border-box;
      display: flex;
      min-block-size: 100%;
      flex-direction: column;
    }
    .codex-sidebar-main { flex: 0 0 auto; }
    .codex-sidebar-articles { margin-block-start: .35rem; }
    .codex-sidebar-empty { padding-inline: .35rem; color: var(--sl-color-gray-3); font-size: .76rem; }
    .codex-sidebar-era-explore { margin: 0 .2rem .4rem; }
    .codex-sidebar-era-explore a { display: block; padding: .22rem .3rem; border-radius: .25rem; color: var(--era-link, var(--sl-color-accent-high)); font-size: .76rem; font-weight: 650; text-decoration: none; }
    .codex-sidebar-era-explore a:hover, .codex-sidebar-era-explore a:focus-visible { background: color-mix(in oklch, var(--codex-accent) 6%, transparent); color: var(--era-link-hover, var(--sl-color-white)); }
    .codex-sidebar-universal { margin-block-start: .5rem; padding-block-start: .4rem; border-top: 1px solid color-mix(in oklch, var(--codex-border) 72%, transparent); }
    .codex-sidebar-universal__label { margin: 0 .3rem .25rem; color: var(--sl-color-gray-3); font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
    .codex-changelog-sidebar {
      margin-block-start: .35rem;
      padding: .35rem 0 0;
      border: 0;
      border-top: 1px solid color-mix(in oklch, var(--codex-border) 72%, transparent);
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      color: var(--sl-color-gray-3);
    }
    @media (min-width: 50rem) {
      .codex-sidebar-layout { min-block-size: calc(100dvh - var(--sl-nav-height, 3.5rem) - 1.5rem); }
    }
    .codex-changelog-sidebar :global(.top-level) { margin: 0; }
    .codex-changelog-sidebar :global(.top-level > li) { margin: 0; padding: 0; border: 0; }
    .codex-changelog-sidebar :global(summary) { margin: 0 0 .1rem; border-top: 0; padding: .1rem .3rem .22rem; color: var(--sl-color-gray-3); }
    .codex-changelog-sidebar :global(.group-label),
    .codex-changelog-sidebar :global(.flex-link) { gap: .35rem; }
    .codex-changelog-sidebar :global(.large) { color: var(--sl-color-gray-3); font-size: .68rem; letter-spacing: .11em; text-transform: uppercase; }
    .codex-changelog-sidebar :global(.caret) { color: var(--sl-color-gray-3); opacity: .65; }
    .codex-changelog-sidebar :global(a) { padding-block: .12rem; border: 0; background: transparent; color: var(--sl-color-gray-3); font-size: .72rem; opacity: .82; }
    .codex-changelog-sidebar :global(a:hover),
    .codex-changelog-sidebar :global(a:focus) { background: transparent; color: var(--sl-color-accent-high); opacity: 1; text-decoration: none; }
  }
</style>
