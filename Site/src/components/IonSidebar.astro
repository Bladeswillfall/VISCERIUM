---
import SidebarSublist from './IonSidebarSublist.astro';
import { parseIconLabel } from '../lib/icon-spec.mjs';
import { HISTORICAL_ERAS, eraFromPath, normaliseEra } from '../lib/era-context.mjs';
import { scopeHistoricalEraBranches } from '../lib/sidebar-era-scope.mjs';

const { sidebar, entry } = Astro.locals.starlightRoute;
const { t } = Astro.locals;
const changelogSidebarLabel = 'Releases';
const labelOf = (entry: any) => parseIconLabel(entry?.label ?? '').label.trim();
const isChangelogGroup = (entry: any) => entry.type === 'group' && labelOf(entry) === changelogSidebarLabel;
const changelogSidebar = sidebar.filter(isChangelogGroup);

const pageData = entry.data;
const pageSlug = String(pageData.slug ?? entry.id ?? '').replace(/\.(md|mdx)$/i, '');
const rawEra = Array.isArray(pageData.era) ? pageData.era[0] : pageData.era;
const routeEra = normaliseEra(rawEra) ?? eraFromPath(pageSlug);
const initialEra = routeEra && HISTORICAL_ERAS.includes(routeEra) ? routeEra : undefined;

// Era mode keeps the full Codex navigation. It hides the historical era branches
// that are outside the active era. Universal material stays in its normal place.
const mainSidebar = scopeHistoricalEraBranches(
  sidebar.filter((entry: any) => !isChangelogGroup(entry)),
  initialEra,
);
const mainGroups = mainSidebar.filter((entry: any) => entry.type === 'group');
const mainArticles = mainSidebar.filter((entry: any) => entry.type === 'link');
---

<div class="codex-sidebar-layout">
  <div class="codex-sidebar-era-toolbar" data-era-sidebar-toolbar aria-label={t('viscerium.era.activeContext')}>
    <strong>
      {HISTORICAL_ERAS.map((era) => <span data-era-sidebar-label={era}>{era}</span>)}
    </strong>
    <a href="/" data-era-exit>{t('viscerium.era.exitAll')}</a>
  </div>

  <div class="codex-sidebar-tree">
    <div class="codex-sidebar-main">
      <SidebarSublist sublist={mainGroups} />
    </div>
    {mainArticles.length > 0 && (
      <div class="codex-sidebar-articles">
        <SidebarSublist sublist={mainArticles} />
      </div>
    )}
  </div>

  {changelogSidebar.length > 0 && (
    <aside class="codex-changelog-sidebar" aria-label={t('viscerium.sidebar.releases')}>
      <SidebarSublist sublist={changelogSidebar} />
    </aside>
  )}
</div>

<script>
  const sidebarEras = ['CITADEL', 'SMOG', 'NEARSIGHT', 'ENTROPY'];
  const sidebarEraRuntime = window.__visceriumSidebarEraBranches ??= {};

  const normaliseSidebarEra = (value) => sidebarEras.find(
    (era) => era.toLowerCase() === String(value ?? '').trim().toLowerCase(),
  ) ?? null;

  const openActiveBranch = (branch) => {
    const branchDetails = [...branch.children].find((child) => child instanceof HTMLDetailsElement);
    const erasDetails = branch.parentElement?.closest('details');
    if (branchDetails instanceof HTMLDetailsElement) branchDetails.open = true;
    if (erasDetails instanceof HTMLDetailsElement) erasDetails.open = true;
  };

  sidebarEraRuntime.sync = (value) => {
    const active = normaliseSidebarEra(value);

    document.querySelectorAll('[data-era-sidebar-branch]').forEach((node) => {
      const branchEra = normaliseSidebarEra(node.getAttribute('data-era-sidebar-branch'));
      node.hidden = Boolean(active && branchEra !== active);
      if (active && branchEra === active) openActiveBranch(node);
    });
  };

  if (!sidebarEraRuntime.bound) {
    document.addEventListener('viscerium:era-context', (event) => {
      sidebarEraRuntime.sync(event instanceof CustomEvent ? event.detail?.era : null);
    });
    document.addEventListener('astro:page-load', () => {
      sidebarEraRuntime.sync(document.documentElement.getAttribute('data-era-context'));
    });
    sidebarEraRuntime.bound = true;
  }

  sidebarEraRuntime.sync(document.documentElement.getAttribute('data-era-context'));
</script>

<style>
  @layer starlight.core {
    .codex-sidebar-layout {
      box-sizing: border-box;
      display: flex;
      min-block-size: 100%;
      flex-direction: column;
    }
    .codex-sidebar-tree,
    .codex-sidebar-main { flex: 0 0 auto; }
    .codex-sidebar-articles { margin-block-start: .28rem; }
    .codex-changelog-sidebar {
      margin-block-start: .5rem;
      padding: .45rem 0 0;
      border: 0;
      border-top: 1px solid color-mix(in oklch, var(--codex-border) 60%, transparent);
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      color: var(--sl-color-gray-3);
    }
    @media (min-width: 50rem) {
      .codex-sidebar-layout { min-block-size: calc(100dvh - var(--sl-nav-height, 3.5rem) - 1.5rem); }
    }
    .codex-changelog-sidebar :global(.top-level) { margin: 0; }
    .codex-changelog-sidebar :global(.top-level > li) { margin: 0; padding: 0; border: 0; }
    .codex-changelog-sidebar :global(summary) {
      min-block-size: var(--codex-sidebar-row-root);
      margin: 0;
      padding: .42rem !important;
      border-top: 0;
      color: var(--sl-color-gray-3);
    }
    .codex-changelog-sidebar :global(.large) {
      color: var(--sl-color-gray-3);
      font-size: var(--codex-sidebar-font-root) !important;
      letter-spacing: .05em;
      text-transform: uppercase;
    }
    .codex-changelog-sidebar :global(.caret) { color: var(--sl-color-gray-3); opacity: .65; }
    .codex-changelog-sidebar :global(a) {
      display: flex;
      min-block-size: var(--codex-sidebar-row-leaf);
      align-items: center;
      border: 0;
      background: transparent;
      color: var(--sl-color-gray-3);
      font-size: var(--codex-sidebar-font-leaf);
      opacity: .82;
    }
    .codex-changelog-sidebar :global(a:hover),
    .codex-changelog-sidebar :global(a:focus) { background: transparent; color: var(--sl-color-accent-high); opacity: 1; text-decoration: none; }
  }
</style>

<style is:global>
  .sidebar-content .codex-sidebar-layout {
    display: flex;
    gap: 0;
  }

  /* Starlight styles these rows outside this CSS layer. Explicit touch heights
     keep the navigation hierarchy sizes consistent. */
  .sidebar-content .codex-sidebar-layout .top-level > li > .ion-expandable-group > summary,
  .sidebar-content .codex-sidebar-layout .top-level > li > a,
  .sidebar-content .codex-sidebar-layout .top-level > li > .empty-group,
  .sidebar-content .codex-changelog-sidebar .top-level > li > .ion-expandable-group > summary {
    min-block-size: var(--codex-sidebar-row-root) !important;
  }

  .sidebar-content .codex-sidebar-layout [data-era-sidebar-branch] > .ion-expandable-group > summary {
    min-block-size: var(--codex-sidebar-row-era) !important;
  }

  .codex-sidebar-era-toolbar {
    display: none;
    min-block-size: var(--codex-sidebar-row-leaf, 2.25rem);
    align-items: center;
    justify-content: space-between;
    gap: .7rem;
    margin: 0 .35rem !important;
    padding: .18rem .4rem !important;
    border: 0 !important;
  }

  html[data-era-context='CITADEL'] .codex-sidebar-era-toolbar,
  html[data-era-context='SMOG'] .codex-sidebar-era-toolbar,
  html[data-era-context='NEARSIGHT'] .codex-sidebar-era-toolbar,
  html[data-era-context='ENTROPY'] .codex-sidebar-era-toolbar {
    display: flex;
  }

  .codex-sidebar-era-toolbar [data-era-sidebar-label] {
    display: none;
  }

  html[data-era-context='CITADEL'] .codex-sidebar-era-toolbar [data-era-sidebar-label='CITADEL'],
  html[data-era-context='SMOG'] .codex-sidebar-era-toolbar [data-era-sidebar-label='SMOG'],
  html[data-era-context='NEARSIGHT'] .codex-sidebar-era-toolbar [data-era-sidebar-label='NEARSIGHT'],
  html[data-era-context='ENTROPY'] .codex-sidebar-era-toolbar [data-era-sidebar-label='ENTROPY'] {
    display: inline;
  }

  .codex-sidebar-era-toolbar strong {
    color: var(--era-link, var(--sl-color-accent-high));
    font-size: var(--codex-sidebar-font-folder, .9375rem);
    font-weight: 720;
    letter-spacing: .055em;
  }

  .codex-sidebar-era-toolbar a {
    padding: .18rem 0;
    color: var(--sl-color-gray-3);
    font-size: var(--codex-sidebar-font-leaf, .875rem);
    text-decoration: none;
  }

  .codex-sidebar-era-toolbar a:hover,
  .codex-sidebar-era-toolbar a:focus-visible {
    color: var(--sl-color-white);
  }

  [data-era-sidebar-branch][hidden] {
    display: none !important;
  }

  html[data-era-context='CITADEL'] [data-era-sidebar-branch]:not([data-era-sidebar-branch='CITADEL']),
  html[data-era-context='SMOG'] [data-era-sidebar-branch]:not([data-era-sidebar-branch='SMOG']),
  html[data-era-context='NEARSIGHT'] [data-era-sidebar-branch]:not([data-era-sidebar-branch='NEARSIGHT']),
  html[data-era-context='ENTROPY'] [data-era-sidebar-branch]:not([data-era-sidebar-branch='ENTROPY']) {
    display: none !important;
  }

  @media (max-width: 49.99rem) {
    .codex-sidebar-era-toolbar {
      min-block-size: var(--codex-sidebar-row-leaf, 2.5rem);
      margin-inline-end: 3.65rem !important;
    }
  }
</style>

<style is:global>
  /* Cinzel identifies world-scale chapters and historical eras. The UI sans-serif
     font identifies categories, folders, and article links. */
  .sidebar-content .codex-sidebar-layout .top-level > li > .ion-expandable-group > summary,
  .sidebar-content .codex-sidebar-layout .top-level > li > a,
  .sidebar-content .codex-sidebar-layout .top-level > li > .empty-group,
  .sidebar-content .codex-changelog-sidebar .top-level > li > .ion-expandable-group > summary {
    font-family: var(--vc-font-display);
    font-weight: 400 !important;
    font-synthesis-weight: none;
  }

  .sidebar-content .codex-sidebar-layout .top-level > li > .ion-expandable-group > summary .large,
  .sidebar-content .codex-sidebar-layout .top-level > li > .empty-group .large,
  .sidebar-content .codex-changelog-sidebar .top-level > li > .ion-expandable-group > summary .large {
    font-family: inherit;
    font-weight: inherit !important;
    font-synthesis-weight: none;
  }

  .sidebar-content .codex-sidebar-layout [data-era-sidebar-branch] > .ion-expandable-group > summary,
  .sidebar-content .codex-sidebar-layout [data-era-sidebar-branch] > .ion-expandable-group > summary .large {
    font-family: var(--vc-font-display);
    font-weight: 400 !important;
    font-synthesis-weight: none;
  }

  @media (min-width: 50rem) {
    .sidebar-content .codex-sidebar-layout {
      --codex-sidebar-font-category: 1rem;
      --codex-sidebar-font-era: 1.125rem;
    }

    .sidebar-content .codex-sidebar-layout .sidebar-list ul {
      margin-inline-start: .875rem;
    }

    .sidebar-content .codex-sidebar-layout [data-era-sidebar-branch] > .ion-expandable-group > summary .large {
      font-size: 1.125rem !important;
    }

    .sidebar-content .codex-sidebar-layout [data-era-sidebar-branch] > .ion-expandable-group > .sidebar-list > li > .ion-expandable-group > summary .large,
    .sidebar-content .codex-sidebar-layout [data-era-sidebar-branch] > .ion-expandable-group > .sidebar-list > li > .empty-group .large {
      font-size: 1rem !important;
    }

    .sidebar-content .codex-sidebar-layout .sidebar-list summary .codex-icon,
    .sidebar-content .codex-sidebar-layout .sidebar-list .empty-group .codex-icon {
      width: 1.0625rem;
      height: 1.0625rem;
      opacity: .9;
    }

    .sidebar-content .codex-sidebar-layout .top-level > li > .ion-expandable-group > summary .codex-icon,
    .sidebar-content .codex-sidebar-layout .top-level > li > .empty-group .codex-icon,
    .sidebar-content .codex-changelog-sidebar .top-level > li > .ion-expandable-group > summary .codex-icon {
      width: 1.1875rem;
      height: 1.1875rem;
    }

    .sidebar-content .codex-sidebar-layout [data-era-sidebar-branch] > .ion-expandable-group > summary .codex-icon {
      width: 1.125rem;
      height: 1.125rem;
    }

    .sidebar-content .codex-sidebar-layout .sidebar-list a .codex-icon {
      width: .875rem;
      height: .875rem;
      opacity: .78;
    }
  }

  @media (max-width: 49.99rem) {
    .sidebar-content .codex-sidebar-layout .sidebar-list summary .codex-icon,
    .sidebar-content .codex-sidebar-layout .sidebar-list .empty-group .codex-icon {
      width: 1.0625rem;
      height: 1.0625rem;
      opacity: .9;
    }

    .sidebar-content .codex-sidebar-layout .top-level > li > .ion-expandable-group > summary .codex-icon,
    .sidebar-content .codex-sidebar-layout .top-level > li > .empty-group .codex-icon,
    .sidebar-content .codex-changelog-sidebar .top-level > li > .ion-expandable-group > summary .codex-icon {
      width: 1.3rem;
      height: 1.3rem;
    }

    .sidebar-content .codex-sidebar-layout [data-era-sidebar-branch] > .ion-expandable-group > summary .codex-icon {
      width: 1.18rem;
      height: 1.18rem;
    }

    .sidebar-content .codex-sidebar-layout .sidebar-list a .codex-icon {
      width: .875rem;
      height: .875rem;
      opacity: .78;
    }
  }
</style>
