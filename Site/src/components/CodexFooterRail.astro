---
import siteConfig from '../../site.config.mjs';
import { visceriumCreativeNotice } from '../config/rights.mjs';

const creativeRightsNotice = visceriumCreativeNotice();
const { t } = Astro.locals;
---

<footer class="ion-codex-footer">
  <div class="footer-grid">
    <section class="footer-brand" aria-label={t('viscerium.footer.rightsLabel')}>
      <span class="footer-brand__mark" aria-hidden="true"></span>
      <h2 class="footer-brand__name">VISCERIUM</h2>
      <p class="footer-brand__notice"><strong>{creativeRightsNotice}</strong></p>
    </section>

    <nav class="footer-wayfinder" aria-label={t('viscerium.footer.destinationsLabel')}>
      <a class="footer-wayfinder__primary" href="/start-here/">{t('viscerium.footer.startHere')}</a>
      <div class="footer-wayfinder__routes">
        <a href="/calendar/">{t('viscerium.footer.calendar')}</a>
        <a href="/graph/">{t('viscerium.footer.worldGraph')}</a>
        <a href="/support/">{t('viscerium.footer.support')}</a>
        <a href="/contact/">{t('viscerium.footer.contact')}</a>
        <a href={siteConfig.githubRepoUrl} target="_blank" rel="noreferrer">
          GitHub<span class="codex-sr-only">{t('viscerium.common.newTab')}</span>
        </a>
        <a href="/rss.xml">RSS</a>
        <a href="/atom.xml">Atom</a>
      </div>
    </nav>

    <aside class="footer-policy">
      <a
        class="policy-link"
        href="/policies/content-production/"
        aria-label={t('viscerium.footer.policyLabel')}
      >
        <span class="policy-mark" aria-hidden="true"></span>
        <span class="policy-link__copy">
          <span class="policy-link__title">{t('viscerium.footer.policyTitle')}</span>
          <span class="policy-link__description">
            {t('viscerium.footer.policyDescription')}
          </span>
        </span>
      </a>
    </aside>
  </div>

  <span class="footer-signature" aria-hidden="true">VISCERIUM</span>
</footer>

<style>
  @layer starlight.core {
    .ion-codex-footer {
      --ion-codex-footer-padding: clamp(3.5rem, 5.5vw, 4.8rem) clamp(0.6rem, 3.5vw, 4rem) clamp(5.2rem, 9vw, 8rem);
      --ion-codex-footer-column-gap: clamp(0.5rem, 2.6vw, 4rem);
      --ion-codex-footer-brand-mark-size: clamp(3rem, 10.5vw, 10.75rem);
      --ion-codex-footer-policy-mark-size: clamp(3.65rem, 13.5vw, 13.25rem);
      position: sticky;
      bottom: 0;
      z-index: -1;
      box-sizing: border-box;
      inline-size: 100%;
      min-block-size: clamp(13rem, 22vw, 20rem);
      margin-top: -20px;
      padding: var(--ion-codex-footer-padding);
      overflow: clip;
      border: 0;
      background: color-mix(in oklch, var(--codex-nav-bg) 90%, var(--codex-palette-deep));
      color: var(--codex-nav-text);
      font-family: var(--vc-font-ui);
    }

    .footer-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
      gap: var(--ion-codex-footer-column-gap);
      inline-size: min(100%, 92rem);
      margin-inline: auto;
    }

    .footer-brand,
    .footer-wayfinder,
    .footer-wayfinder__routes,
    .footer-policy,
    .policy-link,
    .policy-link__copy {
      min-inline-size: 0;
    }

    .footer-brand {
      display: grid;
      align-content: start;
      gap: clamp(0.42rem, 1vw, 0.9rem);
    }

    .footer-brand__mark,
    .policy-mark {
      display: block;
      flex: none;
      background: currentColor;
      -webkit-mask-position: center;
      mask-position: center;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-size: contain;
      mask-size: contain;
    }

    .footer-brand__mark {
      inline-size: min(100%, var(--ion-codex-footer-brand-mark-size));
      aspect-ratio: 1756 / 969;
      color: var(--codex-nav-text);
      -webkit-mask-image: url('/assets/brand/viscerium-logo.svg');
      mask-image: url('/assets/brand/viscerium-logo.svg');
    }

    .footer-brand__name {
      margin: 0;
      color: var(--codex-nav-text);
      font-family: var(--vc-font-display);
      font-size: clamp(0.72rem, 2.35vw, 2.45rem);
      font-weight: 400;
      line-height: 1;
      letter-spacing: clamp(0.025em, 0.25vw, 0.06em);
      overflow-wrap: anywhere;
    }

    .footer-brand__notice {
      max-inline-size: 31rem;
      margin: 0;
      color: var(--codex-nav-text);
      font-size: clamp(0.56rem, 1.05vw, 0.88rem);
      line-height: 1.45;
      overflow-wrap: anywhere;
    }

    .footer-wayfinder {
      display: grid;
      align-content: start;
      gap: clamp(0.9rem, 2vw, 1.8rem);
      padding-block-start: clamp(0.15rem, 0.5vw, 0.55rem);
    }

    .footer-wayfinder__primary {
      inline-size: fit-content;
      max-inline-size: 100%;
      color: var(--codex-nav-text);
      font-family: var(--vc-font-display);
      font-size: clamp(1.05rem, 2.8vw, 2.65rem);
      font-weight: 500;
      line-height: 1;
      letter-spacing: 0.015em;
      text-decoration: none;
      overflow-wrap: anywhere;
    }

    .footer-wayfinder__routes {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: clamp(0.5rem, 1.25vw, 1.15rem) clamp(0.7rem, 2vw, 1.8rem);
      max-inline-size: 44rem;
    }

    .footer-wayfinder__routes a {
      color: var(--codex-nav-muted);
      font-size: clamp(0.58rem, 1.05vw, 0.92rem);
      font-weight: 600;
      line-height: 1.3;
      text-decoration: none;
      overflow-wrap: anywhere;
    }

    .footer-wayfinder a:hover,
    .footer-wayfinder a:focus-visible,
    .policy-link:hover,
    .policy-link:focus-visible {
      color: var(--codex-fixed-light) !important;
    }

    .footer-wayfinder a:focus-visible,
    .policy-link:focus-visible {
      outline: 2px solid var(--codex-nav-text);
      outline-offset: 0.25rem;
    }

    .footer-policy {
      justify-self: end;
      inline-size: 100%;
      max-inline-size: 18rem;
    }

    .policy-link {
      display: grid;
      justify-items: start;
      gap: clamp(0.45rem, 1.1vw, 1rem);
      color: var(--codex-nav-text);
      text-decoration: none;
      transition: color 160ms ease;
    }

    .policy-mark {
      inline-size: min(100%, var(--ion-codex-footer-policy-mark-size));
      aspect-ratio: 1182 / 532;
      -webkit-mask-image: url('/assets/policies/human-made.svg');
      mask-image: url('/assets/policies/human-made.svg');
    }

    .policy-link__copy {
      display: grid;
      gap: clamp(0.18rem, 0.45vw, 0.35rem);
    }

    .policy-link__title {
      color: currentColor;
      font-size: clamp(0.59rem, 1.05vw, 0.92rem);
      font-weight: 700;
      line-height: 1.28;
      overflow-wrap: anywhere;
    }

    .policy-link__description {
      color: var(--codex-nav-text);
      font-size: clamp(0.54rem, 0.9vw, 0.78rem);
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .footer-signature {
      position: absolute;
      z-index: 0;
      inset-inline-start: 50%;
      inset-block-end: -0.13em;
      inline-size: max-content;
      transform: translateX(-50%);
      color: var(--codex-nav-text);
      font-family: var(--vc-font-display);
      font-size: clamp(3rem, 10.5vw, 10rem);
      font-weight: 400;
      line-height: 0.78;
      letter-spacing: clamp(0.035em, 0.3vw, 0.08em);
      opacity: 0.07;
      pointer-events: none;
      user-select: none;
    }

    @media (max-width: 40rem) {
      .ion-codex-footer {
        --ion-codex-footer-padding: 3.1rem clamp(0.6rem, 3vw, 1rem) clamp(4.1rem, 10vw, 5rem);
        --ion-codex-footer-column-gap: clamp(0.45rem, 2vw, 0.8rem);
        --ion-codex-footer-brand-mark-size: clamp(3.15rem, 17vw, 6rem);
        --ion-codex-footer-policy-mark-size: clamp(3.9rem, 20vw, 7.5rem);
      }

      .footer-wayfinder {
        gap: 0.7rem;
      }

      .footer-wayfinder__routes {
        align-items: stretch;
        gap: 0.5rem;
      }

      .footer-wayfinder__routes a {
        display: inline-flex;
        min-inline-size: 3rem;
        min-block-size: 3rem;
        align-items: center;
        justify-content: center;
        padding-inline: 0.15rem;
      }
    }

    @media (max-width: 25rem) {
      .ion-codex-footer {
        --ion-codex-footer-padding: 2.8rem 0.5rem 3.8rem;
        --ion-codex-footer-column-gap: 0.35rem;
        --ion-codex-footer-brand-mark-size: clamp(3rem, 17vw, 4.25rem);
        --ion-codex-footer-policy-mark-size: clamp(3.65rem, 20vw, 5rem);
      }

      .footer-wayfinder__routes {
        gap: 0.5rem;
      }

      .policy-link__description {
        font-size: 0.52rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .policy-link {
        transition: none;
      }
    }

    @media print, (forced-colors: active) {
      .ion-codex-footer {
        position: static;
        z-index: auto;
        min-block-size: auto;
        margin-top: 0;
        overflow: visible;
        background: Canvas;
        color: CanvasText;
      }

      .footer-brand__mark,
      .policy-mark {
        background: CanvasText;
      }

      .footer-signature {
        display: none;
      }
    }
  }
</style>
