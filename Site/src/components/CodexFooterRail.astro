---
import siteConfig from '../../site.config.mjs';
import { visceriumCreativeNotice } from '../config/rights.mjs';

const creativeRightsNotice = visceriumCreativeNotice();
---

<footer class="ion-codex-footer">
  <div class="footer-grid">
    <section class="footer-brand" aria-label="VISCERIUM rights information">
      <span class="footer-brand__mark" aria-hidden="true"></span>
      <h2 class="footer-brand__name">VISCERIUM</h2>
      <p class="footer-brand__notice"><strong>{creativeRightsNotice}</strong></p>
    </section>

    <nav class="footer-links" aria-label="Footer navigation">
      <section class="footer-links__group" aria-labelledby="footer-explore">
        <h2 class="footer-links__heading" id="footer-explore">Explore</h2>
        <a href="/">Start Here</a>
        <a href="/calendar/">Calendar</a>
        <a href="/graph/">World Graph</a>
      </section>

      <section class="footer-links__group" aria-labelledby="footer-connect">
        <h2 class="footer-links__heading" id="footer-connect">Connect</h2>
        <a href="/support/">Support</a>
        <a href="/contact/">Contact</a>
        <a href={siteConfig.githubRepoUrl} target="_blank" rel="noreferrer">
          GitHub
          <span class="codex-sr-only"> (opens in a new tab)</span>
        </a>
      </section>

      <section class="footer-links__group" aria-labelledby="footer-follow">
        <h2 class="footer-links__heading" id="footer-follow">Follow</h2>
        <a href="/rss.xml">RSS</a>
        <a href="/atom.xml">Atom</a>
      </section>
    </nav>

    <aside class="footer-policy">
      <a
        class="policy-link"
        href="/policies/content-production/"
        aria-label="Read the VISCERIUM content and production statement"
      >
        <span class="policy-mark" aria-hidden="true"></span>
        <span class="policy-link__copy">
          <span class="policy-link__title">
            Content &amp; production statement <span aria-hidden="true">→</span>
          </span>
          <span class="policy-link__description">
            How VISCERIUM handles authorship, generative AI, technical assistance, and accountability.
          </span>
        </span>
      </a>
    </aside>
  </div>
</footer>

<style>
  @layer starlight.core {
    .ion-codex-footer {
      --ion-codex-footer-padding: clamp(3.8rem, 6vw, 5rem) clamp(0.5rem, 3.5vw, 4rem) clamp(1.65rem, 3vw, 2.5rem);
      --ion-codex-footer-column-gap: clamp(0.35rem, 2.6vw, 4rem);
      --ion-codex-footer-brand-mark-size: clamp(3rem, 10.5vw, 10.75rem);
      --ion-codex-footer-policy-mark-size: clamp(3.65rem, 13.5vw, 13.25rem);
      position: sticky;
      bottom: 0;
      z-index: -1;
      box-sizing: border-box;
      inline-size: 100%;
      min-block-size: clamp(13rem, 22vw, 20rem);
      margin-top: -20px;
      padding: var(--ion-codex-footer-padding);
      border: 0;
      border-block-start: 1px solid var(--codex-nav-border);
      background: linear-gradient(
        180deg,
        color-mix(in oklch, var(--codex-nav-bg) 78%, var(--codex-palette-deep)),
        var(--codex-nav-bg)
      );
      color: var(--codex-nav-text);
      font-family: var(--vc-font-ui);
    }

    .ion-codex-footer::before {
      content: '';
      position: absolute;
      inset-block-start: 2rem;
      inset-inline-start: 50%;
      inline-size: 3.375rem;
      block-size: 0.1875rem;
      border-radius: 999px;
      transform: translateX(-50%);
      background: var(--codex-nav-border);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
      gap: var(--ion-codex-footer-column-gap);
      inline-size: min(100%, 92rem);
      margin-inline: auto;
    }

    .footer-brand,
    .footer-links,
    .footer-policy,
    .footer-links__group,
    .policy-link,
    .policy-link__copy {
      min-inline-size: 0;
    }

    .footer-brand {
      display: grid;
      align-content: start;
      gap: clamp(0.42rem, 1vw, 0.9rem);
    }

    .footer-brand__mark,
    .policy-mark {
      display: block;
      flex: none;
      background: currentColor;
      -webkit-mask-position: center;
      mask-position: center;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-size: contain;
      mask-size: contain;
    }

    .footer-brand__mark {
      inline-size: min(100%, var(--ion-codex-footer-brand-mark-size));
      aspect-ratio: 1756 / 969;
      color: var(--codex-nav-text);
      -webkit-mask-image: url('/assets/brand/viscerium-logo.svg');
      mask-image: url('/assets/brand/viscerium-logo.svg');
    }

    .footer-brand__name {
      margin: 0;
      color: var(--codex-nav-text);
      font-family: var(--vc-font-display);
      font-size: clamp(0.72rem, 2.35vw, 2.45rem);
      font-weight: 400;
      line-height: 1;
      letter-spacing: clamp(0.025em, 0.25vw, 0.06em);
      overflow-wrap: anywhere;
    }

    .footer-brand__notice {
      max-inline-size: 31rem;
      margin: 0;
      color: var(--codex-text-minor);
      font-size: clamp(0.56rem, 1.05vw, 0.88rem);
      line-height: 1.45;
      overflow-wrap: anywhere;
    }

    .footer-links {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
      gap: clamp(0.25rem, 2vw, 2.25rem);
    }

    .footer-links__group {
      display: grid;
      align-content: start;
      gap: clamp(0.38rem, 0.9vw, 0.75rem);
    }

    .footer-links__heading {
      margin: 0 0 clamp(0.08rem, 0.4vw, 0.4rem);
      color: var(--codex-nav-muted);
      font-family: var(--vc-font-ui);
      font-size: clamp(0.48rem, 0.82vw, 0.7rem);
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: clamp(0.08em, 0.25vw, 0.16em);
      text-transform: uppercase;
      overflow-wrap: anywhere;
    }

    .footer-links a {
      inline-size: fit-content;
      max-inline-size: 100%;
      color: var(--codex-nav-text);
      font-size: clamp(0.61rem, 1.08vw, 0.92rem);
      line-height: 1.3;
      text-decoration: none;
      text-underline-offset: 0.22em;
      overflow-wrap: anywhere;
    }

    .footer-links a:hover,
    .footer-links a:focus-visible,
    .policy-link:hover,
    .policy-link:focus-visible {
      color: var(--codex-fixed-light) !important;
    }

    .footer-links a:hover,
    .footer-links a:focus-visible {
      text-decoration: underline;
    }

    .footer-links a:focus-visible,
    .policy-link:focus-visible {
      outline: 2px solid var(--codex-nav-text);
      outline-offset: 0.25rem;
    }

    .footer-policy {
      justify-self: end;
      inline-size: 100%;
      max-inline-size: 18rem;
    }

    .policy-link {
      display: grid;
      justify-items: start;
      gap: clamp(0.45rem, 1.1vw, 1rem);
      color: var(--codex-nav-text);
      text-decoration: none;
    }

    .policy-mark {
      inline-size: min(100%, var(--ion-codex-footer-policy-mark-size));
      aspect-ratio: 1182 / 532;
      -webkit-mask-image: url('/assets/policies/human-made.svg');
      mask-image: url('/assets/policies/human-made.svg');
      transition: color 160ms ease, transform 160ms ease;
    }

    .policy-link:hover .policy-mark {
      transform: translateY(-0.15rem);
    }

    .policy-link__copy {
      display: grid;
      gap: clamp(0.18rem, 0.45vw, 0.35rem);
    }

    .policy-link__title {
      color: currentColor;
      font-size: clamp(0.59rem, 1.05vw, 0.92rem);
      font-weight: 700;
      line-height: 1.28;
      overflow-wrap: anywhere;
    }

    .policy-link__description {
      display: -webkit-box;
      overflow: hidden;
      color: var(--codex-text-minor);
      font-size: clamp(0.54rem, 0.9vw, 0.78rem);
      line-height: 1.4;
      overflow-wrap: anywhere;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 4;
    }

    @media (max-width: 40rem) {
      .ion-codex-footer {
        --ion-codex-footer-padding: 3.55rem clamp(0.55rem, 3vw, 1rem) 1.65rem;
        --ion-codex-footer-column-gap: clamp(0.4rem, 2vw, 0.75rem);
        --ion-codex-footer-brand-mark-size: clamp(3.15rem, 17vw, 6rem);
        --ion-codex-footer-policy-mark-size: clamp(3.9rem, 20vw, 7.5rem);
      }

      .policy-link__description {
        -webkit-line-clamp: 3;
      }
    }

    @media (max-width: 25rem) {
      .ion-codex-footer {
        --ion-codex-footer-padding: 3.1rem 0.5rem 1.45rem;
        --ion-codex-footer-column-gap: 0.35rem;
        --ion-codex-footer-brand-mark-size: clamp(3rem, 17vw, 4.25rem);
        --ion-codex-footer-policy-mark-size: clamp(3.65rem, 20vw, 5rem);
      }

      .ion-codex-footer::before {
        inset-block-start: 1.6rem;
        inline-size: 2.5rem;
      }

      .policy-link__description {
        -webkit-line-clamp: 2;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .policy-mark {
        transition: none;
      }
    }

    @media print, (forced-colors: active) {
      .ion-codex-footer {
        position: static;
        z-index: auto;
        min-block-size: auto;
        margin-top: 0;
        background: Canvas;
        color: CanvasText;
      }

      .ion-codex-footer::before {
        display: none;
      }

      .footer-brand__mark,
      .policy-mark {
        background: CanvasText;
      }
    }
  }
</style>
