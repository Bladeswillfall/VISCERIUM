---
import { getPublicationDates } from '../lib/publication-dates.mjs';
import { formatDate } from '../lib/i18n.mjs';

const { starlightRoute, t } = Astro.locals;
const data = Astro.locals.starlightRoute.entry.data;
const locale = starlightRoute.lang;
const { published, updated } = getPublicationDates(data);
const sameDay = published && updated
  ? published.toISOString().slice(0, 10) === updated.toISOString().slice(0, 10)
  : false;
const showUpdated = Boolean(updated && (!published || !sameDay));
const dateOptions = {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
};

function dateTimeValue(date) {
  return date.toISOString().slice(0, 10);
}
---

{(published || updated) && (
  <p class="codex-article-dates" aria-label={t('viscerium.article.datesLabel')}>
    {published && (
      <span>
        {t('viscerium.article.published')} <time datetime={dateTimeValue(published)}>{formatDate(published, locale, dateOptions)}</time>
      </span>
    )}
    {published && showUpdated && <span aria-hidden="true">·</span>}
    {showUpdated && updated && (
      <span>
        {t('viscerium.article.updated')} <time datetime={dateTimeValue(updated)}>{formatDate(updated, locale, dateOptions)}</time>
      </span>
    )}
  </p>
)}

<style>
  .codex-article-dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.35rem 0 0.8rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .codex-article-dates time {
    font-variant-numeric: tabular-nums;
  }
</style>
