---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import maps from '../../data/maps.json';

const entries = Object.values(maps).sort((a, b) => String(a.title ?? '').localeCompare(String(b.title ?? '')));
---

<StarlightPage frontmatter={{ title: 'Atlas', description: 'Interactive maps of VISCERIUM and the places recorded within them.' }}>
  <section class="atlas-index">
    <p class="atlas__eyebrow">Explore VISCERIUM</p>
    <h1>Atlas</h1>
    <p>Browse published maps, then use their layers, marker search and nested maps to move from world-scale geography into local detail.</p>

    {entries.length ? (
      <div class="codex-map-grid not-content">
        {entries.map((map) => (
          <article class="codex-map-card">
            {map.image && <img src={map.image} alt="" loading="lazy" />}
            <div class="codex-map-card__body">
              <h2><a href={`/maps/${encodeURIComponent(map.id)}/`}>{map.title}</a></h2>
              {map.description && <p>{map.description}</p>}
              <p class="atlas-index__meta">{map.markers?.length ?? 0} published marker{map.markers?.length === 1 ? '' : 's'}</p>
            </div>
          </article>
        ))}
      </div>
    ) : <p class="codex-warning">No published maps are available yet.</p>}
  </section>
</StarlightPage>

<style is:global>
  .atlas-index .codex-map-grid {
    align-items: stretch;
  }

  .atlas-index .codex-map-card {
    display: flex;
    min-width: 0;
    overflow: hidden;
    flex-direction: column;
  }

  /* Deliberate exception to the global flat-surface rule for image-led Atlas cards. */
  @layer starlight.core {
    .sl-markdown-content .atlas-index .codex-map-card {
      border-radius: .625rem !important;
    }
  }

  .atlas-index .codex-map-card > img {
    display: block;
    width: 100%;
    height: clamp(10.5rem, 20vw, 15rem);
    max-height: 15rem;
    margin: 0;
    flex: none;
    object-fit: cover;
    object-position: center;
  }

  .atlas-index .codex-map-card__body {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    margin: 0;
    padding: 1rem 1rem 1.1rem;
  }

  /* Atlas card headings are navigation labels, not article section headings. */
  .sl-markdown-content .atlas-index .codex-map-card__body > h2 {
    position: static;
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
    font-family: var(--vc-font-display);
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 400;
    letter-spacing: .01em;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .sl-markdown-content .atlas-index .codex-map-card__body > h2::before {
    content: none;
  }

  .atlas-index .codex-map-card__body h2 a {
    display: block;
  }

  .sl-markdown-content .atlas-index .codex-map-card__body > p {
    margin: 0;
    line-height: 1.5;
  }

  .sl-markdown-content .atlas-index .atlas-index__meta {
    margin-top: auto;
    padding-top: 1rem;
    color: var(--sl-color-gray-3);
    font-family: var(--vc-font-ui);
    font-size: var(--sl-text-xs);
    letter-spacing: .025em;
  }
</style>
