---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import WorldGraph from '../components/WorldGraph.astro';
import { buildSiteGraph } from '../lib/site-graph.mjs';

const graph = buildSiteGraph(await getCollection('docs'));
---
<StarlightPage frontmatter={{ title: 'World Graph', description: 'Public links and relationships generated from the Obsidian vault.', explorationPage: true, tableOfContents: false, giscus: false }}>
  <WorldGraph graph={graph} />
</StarlightPage>
