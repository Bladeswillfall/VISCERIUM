---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import TimelineApp from '../../components/timeline/TimelineApp.astro';
import { TIMELINE_IDS } from '../../lib/timeline/core.mjs';
import type { TimelineDataset } from '../../lib/timeline/component-types';

const datasets = import.meta.glob('../../data/timelines/{super,citadel,smog,nearsight,entropy}.json', {
  eager: true,
  import: 'default',
});

export function getStaticPaths() {
  // The eager JSON glob is part of this route's dependency graph, so Astro
  // invalidates all five timeline pages when any generated timeline changes.
  return TIMELINE_IDS.map((id) => ({
    params: { id },
    cacheKey: id,
  }));
}

const id = Astro.params.id;
const timeline = (datasets as Record<string, TimelineDataset & { title: string; description: string }>)[`../../data/timelines/${id}.json`];
if (!timeline) return Astro.redirect('/timelines/');
---

<StarlightPage
  frontmatter={{
    title: timeline.title,
    description: timeline.description,
    timelinePage: true,
  }}
>
  <header class="vc-timeline-page-header">
    <p class="timeline-kicker">Generated chronology</p>
    <p>{timeline.description}</p>
    <p>{timeline.events.length} published event{timeline.events.length === 1 ? '' : 's'}.</p>
  </header>
  <TimelineApp dataset={timeline} />
</StarlightPage>

<style is:global>
  /* Dedicated pages can grow without changing the shared Obsidian renderer. */
  .codex-timeline-page .vc-timeline-app:not(.is-compact) .vc-timeline-canvas,
  .codex-timeline-page .vc-timeline-skeleton:not(.is-compact) .vc-timeline-skeleton-stage {
    block-size: 50vh;
    block-size: 50dvh;
    min-height: 27rem;
    max-height: none;
  }

  /* Override vis-timeline's inline height constraints on dedicated pages. */
  .codex-timeline-page .vc-timeline-app:not(.is-compact) .vc-timeline-canvas > .vis-timeline {
    min-block-size: 100% !important;
    max-block-size: 100% !important;
  }

  @media (max-width: 38rem) {
    .codex-timeline-page .vc-timeline-app:not(.is-compact) .vc-timeline-canvas,
    .codex-timeline-page .vc-timeline-skeleton:not(.is-compact) .vc-timeline-skeleton-stage {
      min-height: 22rem;
    }
  }
</style>
