---
import { createHash } from 'node:crypto';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import TimelineApp from '../../components/timeline/TimelineApp.astro';
import { TIMELINE_IDS } from '../../lib/timeline/core.mjs';
import type { TimelineDataset } from '../../lib/timeline/component-types';

const datasets = import.meta.glob('../../data/timelines/{super,citadel,smog,nearsight,entropy}.json', {
  eager: true,
  import: 'default',
});

export function getStaticPaths() {
  return TIMELINE_IDS.map((id) => {
    const timeline = datasets[`../../data/timelines/${id}.json`];
    return {
      params: { id },
      cacheKey: createHash('sha256').update(JSON.stringify(timeline)).digest('hex'),
    };
  });
}

const id = Astro.params.id;
const timeline = (datasets as Record<string, TimelineDataset & { title: string; description: string }>)[`../../data/timelines/${id}.json`];
if (!timeline) return Astro.redirect('/timelines/');
---

<StarlightPage
  frontmatter={{
    title: timeline.title,
    description: timeline.description,
    timelinePage: true,
  }}
>
  <header class="vc-timeline-page-header">
    <p class="timeline-kicker">Generated chronology</p>
    <h1>{timeline.title}</h1>
    <p>{timeline.description}</p>
    <p>{timeline.events.length} published event{timeline.events.length === 1 ? '' : 's'}.</p>
  </header>
  <TimelineApp dataset={timeline} />
</StarlightPage>
