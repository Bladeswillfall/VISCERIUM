---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SupportHub from '../components/support/SupportHub.astro';
import editorialShellStylesHref from '../styles/editorial-shell.css?url&no-inline';
import supportRedesignStylesHref from '../styles/support-redesign.css?url&no-inline';
---

<StarlightPage
  hasSidebar={false}
  frontmatter={{
    title: 'Support',
    description: 'Report issues, suggest edits, support development, and find official VISCERIUM Codex channels.',
    tableOfContents: false,
    giscus: false,
    head: [
      { tag: 'link', attrs: { rel: 'stylesheet', href: editorialShellStylesHref } },
      { tag: 'link', attrs: { rel: 'stylesheet', href: supportRedesignStylesHref } },
    ],
  }}
>
  <SupportHub />
</StarlightPage>
