---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SupportHub from '../components/support/SupportHub.astro';
import supportRedesignStylesHref from '../styles/support-redesign.css?url&no-inline';
---

<StarlightPage
  hasSidebar={false}
  frontmatter={{
    title: 'Support',
    description: 'Report issues, suggest edits, support development, and find official VISCERIUM Codex channels.',
    tableOfContents: false,
    giscus: false,
    head: [
      { tag: 'link', attrs: { rel: 'stylesheet', href: supportRedesignStylesHref } },
    ],
  }}
>
  <SupportHub />
</StarlightPage>

<style is:global>
  body:has(.support-page) .support-wordmark {
    display: inline-block;
    white-space: nowrap;
    word-break: keep-all;
  }

  body:has(.support-page) .support-placeholder::after {
    content: none;
    display: none;
  }

  body:has(.support-page) .support-placeholder__watermark {
    position: absolute;
    right: -4%;
    bottom: -12%;
    z-index: 0;
    display: block;
    width: 48%;
    aspect-ratio: 1;
    color: color-mix(in oklch, var(--codex-palette-deep) 44%, var(--support-void));
    pointer-events: none;
    user-select: none;
  }

  body:has(.support-page) .support-placeholder__watermark .codex-icon {
    width: 100%;
    height: 100%;
    color: currentColor;
  }

  body:has(.support-page) .support-placeholder__brand {
    position: relative;
    z-index: 1;
  }

  body:has(.support-page) .sl-markdown-content .support-cards {
    grid-auto-rows: 1fr;
    gap: .75rem;
    border: 0;
  }

  body:has(.support-page) .sl-markdown-content .support-card {
    display: grid;
    width: 100%;
    max-width: none;
    min-width: 0;
    grid-template-rows: auto 1fr auto;
    align-self: stretch;
    justify-self: stretch;
    overflow: clip;
    border: 1px solid var(--support-line);
    border-radius: .5rem;
    text-decoration: none;
  }

  body:has(.support-page) .sl-markdown-content .support-card--wide {
    min-height: 17rem;
  }

  body:has(.support-page) .support-card:focus-visible::after {
    border-radius: .25rem;
  }

  body:has(.support-page) .support-placeholder-grid {
    grid-auto-rows: 1fr;
    align-items: stretch;
  }

  body:has(.support-page) .sl-markdown-content .support-placeholder {
    width: 100%;
    max-width: none;
    min-width: 0;
    height: 100%;
    margin: 0;
  }

  body:has(.support-page) .support-placeholder p {
    min-height: 3.1rem;
  }

  body:has(.support-page) .support-socials {
    grid-auto-rows: 1fr;
    gap: .75rem;
    margin: 0;
    padding: 0;
    border: 0;
    list-style: none;
  }

  body:has(.support-page) .sl-markdown-content .support-socials > li {
    display: flex;
    min-width: 0;
    margin: 0;
  }

  body:has(.support-page) .sl-markdown-content .support-socials > li::marker {
    content: none;
  }

  body:has(.support-page) .support-social {
    width: 100%;
    max-width: none;
    min-width: 0;
    min-height: 6.75rem;
    height: 100%;
    gap: .65rem;
    padding: .85rem 1rem;
    border: 1px solid var(--support-line);
    border-radius: 0;
    background: color-mix(in oklch, var(--support-surface) 10%, transparent);
  }

  body:has(.support-page) .support-social--active {
    overflow: clip;
    border-radius: 0;
    text-decoration: none;
  }

  body:has(.support-page) .support-contact {
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
    border-top: 1px solid var(--support-line);
    background: color-mix(in oklch, var(--support-surface) 68%, var(--support-bg));
    color: var(--support-body);
  }

  body:has(.support-page) .support-contact::before {
    content: none;
    display: none;
  }

  body:has(.support-page) .support-contact__inner {
    align-items: center;
  }

  body:has(.support-page) .support-contact .support-eyebrow {
    color: var(--support-accent);
  }

  body:has(.support-page) .sl-markdown-content .support-contact h2 {
    max-width: 18ch;
    margin: 0 0 .8rem;
    color: var(--support-text);
    font-size: clamp(2.35rem, 1.8rem + 2vw, 4.3rem);
    line-height: 1;
  }

  body:has(.support-page) .support-contact p {
    color: var(--support-body);
  }

  body:has(.support-page) .support-contact__action {
    border-color: var(--support-accent);
    border-radius: 999px;
    background: var(--support-accent);
    color: var(--support-bg) !important;
  }

  body:has(.support-page) .support-contact__action:focus-visible::after {
    border-radius: 999px;
  }

  body:has(.support-page) .support-contact__action:hover,
  body:has(.support-page) .support-contact__action:focus-visible {
    border-color: var(--support-text);
    background: var(--support-text);
    color: var(--support-bg) !important;
  }

  :root[data-theme='light'] body:has(.support-page) .support-placeholder__watermark {
    color: color-mix(in oklch, var(--support-fixed-text) 10%, transparent);
  }

  :root[data-theme='light'] body:has(.support-page) .support-card:hover,
  :root[data-theme='light'] body:has(.support-page) .support-card:focus-visible,
  :root[data-theme='light'] body:has(.support-page) .support-social--active:hover,
  :root[data-theme='light'] body:has(.support-page) .support-social--active:focus-visible {
    background: var(--support-surface);
  }

  :root[data-theme='light'] body:has(.support-page) .support-contact__action:hover,
  :root[data-theme='light'] body:has(.support-page) .support-contact__action:focus-visible {
    border-color: var(--codex-palette-mid);
    background: var(--codex-palette-deep);
    color: var(--codex-palette-light) !important;
  }

  @media (max-width: 48rem) {
    body:has(.support-page) .support-hero h1 {
      font-size: clamp(2.75rem, 13.5vw, 6.2rem);
    }

    body:has(.support-page) .support-placeholder p {
      min-height: 0;
    }
  }

  @media (max-width: 30rem) {
    body:has(.support-page) .support-hero h1 {
      font-size: clamp(2.6rem, 11.75vw, 3.6rem);
    }

    body:has(.support-page) .support-wordmark {
      display: block;
      font-size: .9em;
      letter-spacing: 0;
    }
  }
</style>
