---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import HomeGateway from '../components/home/HomeGateway.astro';
import homepageStyles from '../styles/homepage.css?raw';
---

<StarlightPage
  frontmatter={{
    title: 'VISCERIUM Codex',
    description: 'One timeline, four eras, infinite stories. Enter the public worldbuilding codex for VISCERIUM.',
    template: 'splash',
    pagefind: false,
    giscus: false,
    head: [{ tag: 'style', content: homepageStyles }],
  }}
  hasSidebar={true}
>
  <HomeGateway />
</StarlightPage>

<style is:global>
  .main-frame:has(.home-gateway) {
    max-inline-size: none !important;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
  }

  html[data-codex-desktop-sidebar]:not(.codex-sidebar-collapsed) .main-frame:has(.home-gateway) {
    padding-inline-start: var(--codex-sidebar-overlay-width) !important;
  }

  .main-frame:has(.home-gateway) > .codex-two-column-content {
    inline-size: 100% !important;
    max-inline-size: none !important;
    margin-inline: 0 !important;
  }

  main:has(.home-gateway) .sl-markdown-content {
    padding: 0 !important;
  }

  .home-gateway .home-era-gateway > li {
    margin-block: 0;
  }

  #home-routes,
  #home-continuum {
    padding-block: clamp(4.5rem, 8vw, 8rem);
  }

  #home-continuum {
    border-block-start: 1px solid var(--home-line);
  }

  @media (max-width: 68.75rem) {
    #home-routes,
    #home-continuum {
      content-visibility: auto;
      contain-intrinsic-block-size: auto 40rem;
    }

    .home-era-card :is(.home-era-card__number, .home-era-card__action) {
      color: color-mix(in oklch, var(--home-era-accent) 80%, var(--home-text-fixed));
    }
  }

  @media (max-width: 44rem) {
    .home-hero__copy {
      filter: none;
    }

    .home-era-scroll-hint {
      display: none;
    }

    .home-era-gateway {
      grid-auto-flow: row;
      grid-auto-columns: unset;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .65rem;
      padding: 0 1rem 1rem;
      overflow: visible;
      scroll-padding-inline: 0;
      scroll-snap-type: none;
      scrollbar-width: auto;
    }

    .home-era-gateway > li {
      scroll-snap-align: none;
      scroll-snap-stop: normal;
    }

    .home-era-card,
    .home-era-gateway > li:last-child .home-era-card {
      min-height: 15rem;
      padding: .9rem;
    }

    .home-era-card h2 {
      font-size: clamp(1.35rem, 7vw, 2rem);
    }

    .home-era-card__tags {
      font-size: .6rem;
      letter-spacing: .08em;
    }

    .home-era-card__description {
      display: none;
    }

    .home-era-card__action {
      min-height: 0;
      margin-block-start: .55rem;
      font-size: .62rem;
      letter-spacing: .08em;
    }

    .home-route-card {
      min-height: 14rem;
    }
  }

  @media (min-width: 68.76rem) {
    .home-hero {
      width: 100%;
      max-width: none;
      margin-inline: 0;
    }

    .home-era-gateway {
      min-height: clamp(44rem, calc(100svh - var(--sl-nav-height)), 80rem);
    }
  }
</style>
