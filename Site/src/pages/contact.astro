---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import siteConfig from '../../site.config.mjs';

const contactForm = siteConfig.contactForm;
---

<StarlightPage frontmatter={{ title: 'Contact', description: 'Contact options for the VISCERIUM Codex.' }}>
  <section class="support-page support-page--contact">
    <header class="support-hero codex-frame">
      <p class="codex-kicker">Private contact</p>
      <h1>Contact us</h1>
      <p>
        {contactForm.enabled
          ? 'Use this form for collaboration, rights, credit, or sensitive concerns. Public site issues still belong on GitHub.'
          : 'Private messages are not available right now. Public, trackable issues can still be opened through GitHub.'}
      </p>
    </header>

    <section class="support-note codex-frame">
      <h2>Use GitHub for public site issues</h2>
      <p>
        For typos, broken links, site bugs, feature requests, or content corrections, use the public support routes.
        This keeps the work visible and easier to track.
      </p>
      <a class="support-button" href="/support/">Open support page</a>
    </section>

    {contactForm.enabled ? (
      <section class="support-form-section codex-frame" aria-labelledby="private-message-title">
        <div>
          <h2 id="private-message-title">Send a private message</h2>
          <p>All fields are required. Messages are checked before delivery.</p>
        </div>
        <form class="support-form" method="post" enctype="multipart/form-data" action={contactForm.endpoint}>
          <div class="support-form__field">
            <label for="contact-name">Name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="120" required />
          </div>
          <div class="support-form__field">
            <label for="contact-email">Email</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
          </div>
          <div class="support-form__field">
            <label for="contact-subject">Subject</label>
            <input id="contact-subject" name="subject" type="text" maxlength="160" required />
          </div>
          <div class="support-form__field">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows="8" maxlength="5000" required></textarea>
          </div>
          <div class="support-form__honeypot" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input id="contact-website" name="website" type="text" autocomplete="off" tabindex="-1" />
          </div>
          <div
            class="cf-turnstile"
            data-sitekey={contactForm.turnstileSiteKey}
            data-action="contact"
          ></div>
          <button class="support-button" type="submit">Send message</button>
        </form>
        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
      </section>
    ) : (
      <section class="support-note codex-frame">
        <h2>Private messages</h2>
        <p>Private contact is currently unavailable. Use GitHub for public questions and keep sensitive details out of public issues.</p>
      </section>
    )}
  </section>
</StarlightPage>
