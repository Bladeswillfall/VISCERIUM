PUBLIC_GISCUS_MAPPING="pathname"
PUBLIC_GISCUS_REACTIONS_ENABLED="1"
PUBLIC_GISCUS_INPUT_POSITION="bottom"
PUBLIC_GISCUS_LOADING="lazy"

# Webmentions stay disabled until www.viscerium.co.uk is registered and verified at Webmention.io.
PUBLIC_WEBMENTIONS_ENABLED="0"
PUBLIC_WEBMENTION_IO_USERNAME="www.viscerium.co.uk"
PUBLIC_WEBMENTION_ENDPOINT=""
PUBLIC_WEBMENTION_PINGBACK_ENDPOINT=""
