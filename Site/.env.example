PUBLIC_GOOGLE_SITE_VERIFICATION=""

# The static page can post to a separately deployed HTTPS Worker.
PUBLIC_CONTACT_FORM_ENABLED="0"
PUBLIC_CONTACT_FORM_ENDPOINT=""
