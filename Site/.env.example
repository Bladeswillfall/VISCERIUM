# Public analytics identifiers. Each provider stays disabled unless its flag and valid ID are set.
PUBLIC_GA4_ENABLED="0"
PUBLIC_GA4_MEASUREMENT_ID=""
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_ENABLED="0"
